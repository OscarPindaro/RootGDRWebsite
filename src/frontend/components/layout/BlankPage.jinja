{#def title #}
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — {{ app_name }}</title>
  {# Fonts are self-hosted (see main.css); preload the two regular faces the
     first paint needs, so headings and body text swap in without a flash. #}
  <link rel="preload" href="/static/fonts/newsreader-latin-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/ibm-plex-sans-latin-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/main.css">
  {{ catalog.render_assets() }}
</head>
<body hx-ext="json-enc">
  {{ content }}
  <script src="/static/js/htmx.min.js"></script>
  <script src="/static/js/json-enc.min.js"></script>
  <script src="/static/js/feedback.js"></script>
  <script src="/static/js/format-times.js"></script>
  {% if replay_enabled %}<script src="/static/js/replay.js"></script>{% endif %}
  <script>
    /* Load the editor bundle only where there is a Markdown field. Readers
       never download it, and it is re-checked after htmx swaps. */
    (function () {
      function loadEditor() {
        if (window.__editorLoaded) return;
        if (!document.querySelector("[data-markdown-field]") &&
            !document.querySelector("[data-doc-edit]:not([data-readonly='true'])") &&
            !document.querySelector("[data-doc-identity]:not([data-readonly='true'])")) return;
        window.__editorLoaded = true;
        var script = document.createElement("script");
        script.src = "/static/js/editor.js";
        script.defer = true;
        document.body.appendChild(script);
      }
      loadEditor();
      document.body.addEventListener("htmx:afterSwap", loadEditor);
    })();
  </script>
</body>
</html>
