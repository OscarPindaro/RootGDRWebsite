{#def current_user=None, active=None, world=None, nav=None, pages=None, symbol_style="icons" #}
{#css common/Avatar.css, common/Button.css, common/Menu.css, common/Tooltip.css, layout/UserMenu.css, layout/Rail.css, common/Icon.css #}
<aside class="rail" id="rail">
  <div class="rail__inner">
    {% if world %}
    <div class="rail__top">
      <a class="rail__back" href="/worlds">← Tutti i mondi</a>
    </div>
    <div class="rail__identity">
      <span class="rail__mark" aria-hidden="true"></span>
      <div>
        <a class="rail__world" href="/worlds/{{ world.id }}">{{ world.name }}</a>
        <div class="rail__role">{{ world.role }}</div>
      </div>
    </div>
    <nav class="rail__nav" aria-label="Navigazione del mondo">
      {% for item in nav %}<layout.RailItem :item="item" :active="active" :style="symbol_style" />{% endfor %}
    </nav>
    {% if pages %}
    <div class="rail__label">Pagine</div>
    <nav class="rail__nav" aria-label="Pagine statiche">
      {% for p in pages %}
      <a class="navitem" href="{{ p.href }}">
        <common.Mark role="pagina" :style="symbol_style" class="navitem__mark navitem__mark--sub" />
        <span class="navitem__text">{{ p.label }}</span>
      </a>
      {% endfor %}
    </nav>
    {% endif %}
    {% else %}
    <div class="rail__top">
      <a class="rail__back" href="/">Root GDR</a>
    </div>
    <div class="rail__identity">
      <span class="rail__mark" aria-hidden="true"></span>
      <div>
        <a class="rail__world" href="/">Archivio</a>
        <div class="rail__role">Root GDR</div>
      </div>
    </div>
    <nav class="rail__nav" aria-label="Navigazione principale">
      {% for item in nav %}<layout.RailItem :item="item" :active="active" :style="symbol_style" />{% endfor %}
    </nav>
    {% endif %}
    <div class="rail__foot">
      <common.Button variant="text" size="sm" data-open-palette
                     aria-keyshortcuts="Alt+Space Control+K Meta+K">
        <span class="mono">Cerca</span><span class="mono muted">Alt+Spazio · Ctrl K</span>
      </common.Button>
      {% if current_user %}
      <layout.UserMenu current_user={{ current_user }} />
      {% endif %}
    </div>
  </div>
</aside>
