{#def title, current_user=None, active=None, world=None, nav=None, pages=None, symbol_style="icons", wide=False #}
{#css common/Avatar.css, common/Button.css, common/Menu.css, common/Tooltip.css, layout/UserMenu.css #}
{% set resolved_nav = nav if nav is not none else global_nav(active, (current_user.role == 'admin') if current_user else False, env) %}
<layout.BlankPage :title="title">
  <div class="shell">
    <layout.Rail :current_user="current_user" :active="active" :world="world" :nav="resolved_nav" :pages="pages" :symbol_style="symbol_style" />
    <div class="scrim" id="scrim"></div>
    <div class="main">
      <layout.Topbar :title="title" />
      <main id="main">
        <div class="container{{ ' container--wide' if wide else '' }}">
          {{ content }}
        </div>
      </main>
    </div>
    <layout.Palette :world_id="world.id if world else None" />
  </div>
</layout.BlankPage>
