{#def world_id=None #}
{#css layout/Palette.css #}
{#js common/Dialog.js, layout/Palette.js #}
<dialog class="palette" id="palette" data-dialog
        data-world-id="{{ world_id or '' }}" aria-label="Cerca nell'archivio">
  <div class="palette__box">
    <input class="palette__input" id="palette-input" type="text" role="combobox"
           aria-expanded="false" aria-controls="palette-list" aria-autocomplete="list"
           autocomplete="off" spellcheck="false"
           placeholder="Cerca mondi, personaggi, luoghi…" aria-label="Cerca"
           data-dialog-autofocus>
    <ul class="palette__list" id="palette-list" role="listbox" aria-label="Risultati"></ul>
    <div class="palette__state" data-palette-state hidden>
      <p class="palette__message" data-palette-message></p>
      <button class="palette__retry" type="button" data-palette-retry hidden>Riprova</button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-palette-status></p>
  </div>
</dialog>
