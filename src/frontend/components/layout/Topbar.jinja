{#def title #}
{#css common/Button.css, layout/Topbar.css, common/Icon.css #}
<header class="topbar">
  <common.Button icon="menu" icon_only shape="square" variant="secondary"
                 label="Apri la navigazione" id="drawer-toggle" aria-expanded="false" />
  <span class="topbar__title">{{ title }}</span>
  <div class="topbar__actions">
    <common.Button variant="text" size="sm" data-open-palette
                   aria-keyshortcuts="Alt+Space Control+K Meta+K">
      <span class="mono">Cerca</span><span class="topbar__hint mono muted">Ctrl K</span>
    </common.Button>
    <common.Button icon="file-text" icon_only shape="square" variant="secondary"
                   label="Segnala un problema" data-dialog-open="report-panel" />
  </div>
</header>
