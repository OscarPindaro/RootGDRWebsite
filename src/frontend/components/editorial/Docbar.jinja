{#def base, eyebrow=None, locked=False, is_draft=False, can_manage=False, badge=None, owner_label=None #}
{#css common/Button.css, common/Pill.css, editorial/Docbar.css #}
{#js common/Dialog.js #}
{# The document bar: facts on the left, commands on the right. `base` is the
   document's own URL prefix, so the lock/publish/delete commands and the
   confirmation fragment are all derived from it and every document gets the
   same commands in the same order. The caller's `content` is a command slot
   for a document-specific control (the place's current scene); it lands after
   the shared commands and before the destructive one. #}
<div class="docbar">
  <div class="docbar__status">
    <span class="eyebrow">{{ eyebrow }}</span>
    {% if is_draft %}
    <common.Pill variant="draft">Bozza</common.Pill>
    {% else %}
    <common.Pill variant="plain">Pubblicato</common.Pill>
    {% endif %}
    {% if owner_label %}<common.Pill variant="plain">{{ owner_label }}</common.Pill>{% endif %}
    {% if badge %}<common.Pill variant="forest">{{ badge }}</common.Pill>{% endif %}
  </div>
  {% if can_manage %}
  <div class="docbar__commands">
    {% if not locked %}
    <common.Button variant="primary" size="sm" icon="pencil"
            data-doc-edit-open data-testid="document-edit">Modifica</common.Button>
    {% endif %}
    <common.Button variant="secondary" size="sm"
            :icon="'lock' if locked else 'lock-open'" :selected="locked"
            data-testid="document-lock"
            :hx-post="base ~ '/toggle/locked?value=' ~ ('false' if locked else 'true')"
            hx-swap="none">{{ 'Bloccato' if locked else 'Sbloccato' }}</common.Button>
    <common.Button variant="secondary" size="sm"
            :icon="'upload' if is_draft else 'undo-2'"
            data-testid="document-publication"
            :hx-post="base ~ '/toggle/is_draft?value=' ~ ('false' if is_draft else 'true')"
            hx-swap="none">{{ 'Pubblica' if is_draft else 'Riporta a bozza' }}</common.Button>
    {{ content }}
    {% if is_draft %}
    <common.Button variant="danger" size="sm" icon="trash-2"
            data-testid="document-cancel-draft"
            :hx-get="base ~ '/confirm/cancel-draft'"
            hx-target="#docbar-confirm" hx-swap="innerHTML">Annulla bozza</common.Button>
    {% else %}
    <common.Button variant="danger" size="sm" icon="trash-2"
            data-testid="document-delete"
            :hx-get="base ~ '/confirm/delete'"
            hx-target="#docbar-confirm" hx-swap="innerHTML">Elimina</common.Button>
    {% endif %}
  </div>
  {% endif %}
  <div id="docbar-confirm"></div>
</div>
