{#def base, eyebrow=None, locked=False, is_draft=False, can_manage=False, badge=None, owner_label=None #}
{#css common/Button.css, common/Pill.css, common/Menu.css, common/Dialog.css, editorial/Docbar.css, editorial/PublicationStatus.css, common/Icon.css, common/Tooltip.css #}
{#js common/Dialog.js, common/Menu.js #}
{# The document bar: facts on the left, commands on the right. `base` is the
   document's own URL prefix, so the lock/publish/delete commands and the
   confirmation fragment are all derived from it and every document gets the
   same commands in the same order. The caller's `content` is a command slot
   for a document-specific control (the place's current scene); it lands after
   the shared commands and before the secondary menu.

   The commands are icon-only: each carries an Italian accessible label and
   tooltip that name the action it performs now (`Blocca`/`Sblocca`,
   `Pubblica`/`Riporta a bozza`). Destructive actions stay behind a labelled
   menu that invokes the same confirmation dialogs as before. #}
<div class="docbar">
  <div class="docbar__status">
    <span class="eyebrow">{{ eyebrow }}</span>
    <editorial.PublicationStatus :is_draft="is_draft" />
    {% if owner_label %}<common.Pill variant="plain">{{ owner_label }}</common.Pill>{% endif %}
    {% if badge %}<common.Pill variant="forest">{{ badge }}</common.Pill>{% endif %}
  </div>
  {% if can_manage %}
  <div class="docbar__commands">
    {% if not locked %}
    <common.IconButton icon="pencil" label="Modifica"
            variant="primary" aria-keyshortcuts="F2"
            data-doc-edit-open data-testid="document-edit" />
    {% endif %}
    <common.IconButton :icon="'lock' if locked else 'lock-open'"
            :label="'Sblocca' if locked else 'Blocca'" :selected="locked"
            data-requires-saved
            data-testid="document-lock"
            :hx-post="base ~ '/toggle/locked?value=' ~ ('false' if locked else 'true')"
            hx-swap="none" />
    <common.IconButton :icon="'upload' if is_draft else 'undo-2'"
            :label="'Pubblica' if is_draft else 'Riporta a bozza'"
            aria-keyshortcuts="Control+Shift+Enter Meta+Shift+Enter"
            data-requires-saved
            data-testid="document-publication"
            :hx-post="base ~ '/toggle/is_draft?value=' ~ ('false' if is_draft else 'true')"
            hx-swap="none" />
    {{ content }}
    <common.MenuTrigger icon="ellipsis-vertical" label="Altre azioni"
            target="docbar-more" variant="secondary" icon_only />
    <common.Menu id="docbar-more" labelledby="docbar-more-trigger" placement="bottom-end">
      <common.MenuItem icon="list" label="Scorciatoie" data-dialog-open="docbar-shortcuts" />
      {% if is_draft %}
      <common.MenuItem icon="trash-2" label="Annulla bozza" variant="danger"
              data-testid="document-cancel-draft"
              :hx-get="base ~ '/confirm/cancel-draft'"
              hx-target="#docbar-confirm" hx-swap="innerHTML" />
      {% else %}
      <common.MenuItem icon="trash-2" label="Elimina" variant="danger"
              data-testid="document-delete"
              :hx-get="base ~ '/confirm/delete'"
              hx-target="#docbar-confirm" hx-swap="innerHTML" />
      {% endif %}
    </common.Menu>
  </div>
  <common.Dialog title="Scorciatoie" id="docbar-shortcuts">
    <dl class="docbar__shortcuts">
      <dt>F2</dt><dd>Apri il blocco attivo, o il corpo del documento</dd>
      <dt>Ctrl/⌘ + Invio</dt><dd>Mostra il risultato e chiudi la scrittura</dd>
      <dt>Ctrl/⌘ + Shift + Invio</dt><dd>Pubblica, o riporta a bozza</dd>
      <dt>Esc</dt><dd>Esci dalla scrittura</dd>
      <dt>↑ / ↓</dt><dd>Passa fra i blocchi del documento</dd>
    </dl>
  </common.Dialog>
  {% endif %}
  <div id="docbar-confirm"></div>
</div>
