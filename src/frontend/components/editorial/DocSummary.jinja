{#def world_id, base, value, value_html, version, can_manage=False, locked=False #}
{#css editorial/DocSummary.css, editorial/Reference.css #}
<div class="docsummary" data-doc-summary data-world-id="{{ world_id }}"
     data-autosave-url="/api{{ base }}" data-autosave-version="{{ version }}"
     {% if locked or not can_manage %}data-readonly="true"{% endif %}>
  <textarea name="body" data-summary-source hidden>{{ value }}</textarea>
  <div class="docsummary__editor" data-summary-editor hidden></div>
  <span class="eyebrow">Sintesi</span>
  <div class="docsummary__render prose" data-summary-render data-doc-block="summary"
       {% if not (locked or not can_manage) %}tabindex="0"{% endif %}>{{ value_html }}</div>
  <button type="button" hidden data-summary-preview
          hx-post="/worlds/{{ world_id }}/preview"
          hx-include="closest [data-doc-summary]"
          hx-target="previous [data-summary-render]"
          hx-swap="innerHTML"></button>
</div>
