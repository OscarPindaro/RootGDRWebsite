{#def title, drawing_id=None, version=None, scene=None, save_url=None, editable=True #}
{#css editorial/DrawingEditor.css, common/Button.css, common/Field.css, common/Icon.css, common/Tooltip.css, common/Dialog.css, common/Menu.css #}
{#js common/Dialog.js, common/Menu.js, editorial/DrawingEditor.js #}
{% set artboard = scene.artboard if scene else None %}
{% set objects = scene.nodes if scene else [] %}
{% set selected = objects[0] if objects and objects[0].kind != 'group' else None %}
<div class="drawing-editor"
     data-drawing-editor
     data-title="{{ title | e }}"
     {% if drawing_id %}data-drawing-id="{{ drawing_id }}"{% endif %}
     {% if save_url %}data-save-url="{{ save_url }}"{% endif %}
     {% if version %}data-version="{{ version }}"{% endif %}
     {% if not editable %}data-readonly="true"{% endif %}>
  {% if scene %}<script type="application/json" data-drawing-scene>{{ scene.model_dump(mode='json', by_alias=True) | tojson }}</script>{% endif %}
  <header class="drawing-editor__bar">
    {% if editable %}<input class="drawing-editor__name" data-drawing-title aria-label="Nome del disegno" maxlength="255" value="{{ title | e }}" />{% else %}<h2 class="drawing-editor__title">{{ title | e }}</h2>{% endif %}
    <div class="drawing-editor__commands">
      <common.Button variant="secondary" size="sm" icon="undo-2" disabled={{ not editable }} data-drawing-undo data-testid="drawing-undo">Annulla</common.Button>
      <common.Button variant="secondary" size="sm" icon="redo-2" disabled={{ not editable }} data-drawing-redo data-testid="drawing-redo">Ripeti</common.Button>
      <common.Button variant="primary" size="sm" icon="save" disabled={{ not editable }} data-testid="drawing-save">Salva</common.Button>
      <common.IconButton icon="ellipsis-vertical" label="Comandi canvas (/)" id="drawing-context-trigger" popovertarget="drawing-context-menu" aria-haspopup="menu" aria-expanded="false" data-drawing-context disabled={{ not editable }} />
      <common.IconButton icon="file-text" label="Scorciatoie" data-dialog-open="drawing-help" data-drawing-help disabled={{ not editable }} />
    </div>
  </header>

  <p class="drawing-editor__hint" data-testid="drawing-desktop-hint">
    Disegno con mouse e tastiera: trascina i vertici, <kbd>Ctrl</kbd>+<kbd>Z</kbd> annulla,
    <kbd>Ctrl</kbd>+<kbd>S</kbd> salva.
  </p>
  <p class="drawing-editor__phone-note" data-testid="drawing-phone-note">
    Da telefono il disegno è solo un’anteprima. Apri questa tavola da un computer
    per modificarla.
  </p>
  <p class="drawing-editor__error" data-drawing-error role="alert" hidden></p>
  <div class="drawing-editor__actions" data-drawing-conflict-actions hidden>
    <common.Button size="sm" variant="secondary" data-drawing-save-copy>Salva come copia</common.Button>
    <common.Button size="sm" variant="secondary" data-dialog-open="drawing-reload">Ricarica</common.Button>
  </div>
  <common.Dialog title="Scarta le modifiche locali?" id="drawing-reload">
    <p>La versione salvata sostituirà le modifiche non salvate.</p>
    <common.Button variant="secondary" size="sm" data-dialog-close>Annulla</common.Button>
    <common.Button variant="danger" size="sm" data-drawing-reload>Scarta e ricarica</common.Button>
  </common.Dialog>

  <common.Menu id="drawing-context-menu" labelledby="drawing-context-trigger" class="drawing-editor__context-menu">
    {% for action, label, icon in [('select', 'Seleziona', 'mouse-pointer-2'), ('edit', 'Modifica forma', 'spline'), ('transform', 'Trasforma (T)', 'grid-2x2'), ('duplicate', 'Duplica', 'copy'), ('delete', 'Elimina sottoscena', 'trash-2'), ('group', 'Raggruppa', 'grid-2x2'), ('ungroup', 'Separa', 'list'), ('forward', 'Porta avanti', 'chevron-up'), ('backward', 'Porta indietro', 'chevron-down'), ('front', 'Primo piano', 'chevron-up'), ('back', 'Sfondo', 'chevron-down'), ('unlock', 'Sblocca geometria', 'lock-open'), ('undo', 'Annulla', 'undo-2'), ('redo', 'Ripeti', 'redo-2'), ('save', 'Salva', 'save')] %}
    <common.MenuItem label={{ label }} icon={{ icon }} data-drawing-command={{ action }} disabled={{ not editable }} />
    {% endfor %}
  </common.Menu>
  <common.Dialog title="Scorciatoie del disegno" id="drawing-help" manual={{ True }}>
    <ul class="prose">
      <li><kbd>T</kbd>: Trasforma la selezione.</li>
      <li><kbd>/</kbd>: Comandi canvas. <kbd>Ctrl/⌘ + K</kbd>: ricerca nel sito.</li>
      <li><kbd>Ctrl/⌘ + S</kbd>: Salva, anche dai campi di testo.</li>
      <li><kbd>Ctrl/⌘ + Z</kbd>: Annulla; <kbd>Ctrl/⌘ + Shift + Z</kbd> o <kbd>Ctrl + Y</kbd>: Ripeti.</li>
      <li><kbd>Delete</kbd> o <kbd>Backspace</kbd>: elimina la sottoscena selezionata; <kbd>Ctrl/⌘ + D</kbd>: Duplica.</li>
      <li>Frecce sulla tavola: sposta la selezione. Sui controlli modifica il punto/raggio; nella scena naviga l’albero. <kbd>Shift</kbd>: passo più grande.</li>
      <li>Trascinamento centrale o <kbd>Spazio</kbd> + trascinamento sinistro: sposta la vista.</li>
      <li>Doppio clic sul bordo in Modifica forma: inserisce un punto. I controlli sul bordo cambiano il contorno con un clic.</li>
      <li>Poligono in creazione: <kbd>Enter</kbd> o doppio clic chiude; <kbd>Escape</kbd> annulla.</li>
      <li><kbd>Shift</kbd> conserva le proporzioni in Trasforma; <kbd>Alt</kbd> esclude gli agganci, non i vincoli.</li>
      <li><kbd>Shift</kbd> + clic destro conserva il menu del browser. Testi e dialoghi mantengono le proprie scorciatoie.</li>
      <li><kbd>Ctrl + T</kbd> resta Nuova scheda del browser; <kbd>Alt + Spazio</kbd> può essere riservato dal sistema operativo.</li>
    </ul>
  </common.Dialog>

  <div class="drawing-editor__selection-bar" data-drawing-selection-bar role="toolbar" aria-label="Selezione e agganci">
    <common.IconButton icon="mouse-pointer-2" label="Seleziona" data-tool="select" data-testid="drawing-tool-select" selected={{ True }} disabled={{ not editable }} />
    <common.IconButton icon="spline" label="Modifica forma" data-drawing-mode="vertex" disabled={{ not editable }} />
    <common.IconButton icon="grid-2x2" label="Trasforma (T)" data-drawing-mode="transform" disabled={{ not editable }} />
    <span class="hint" data-drawing-mode-label aria-live="polite">Seleziona</span>
    <common.IconButton icon="grid-2x2" label="Raggruppa" data-drawing-group data-testid="drawing-group" disabled={{ not editable }} />
    <common.IconButton icon="list" label="Separa" data-drawing-ungroup data-testid="drawing-ungroup" disabled={{ not editable }} />
    <common.IconButton icon="copy" label="Duplica" data-drawing-duplicate data-testid="drawing-duplicate" disabled={{ not editable }} />
    <common.IconButton icon="trash-2" label="Elimina" data-drawing-delete data-testid="drawing-delete" disabled={{ not editable }} />
    <common.IconButton icon="chevron-up" label="Porta avanti" data-drawing-order="1" disabled={{ not editable }} />
    <common.IconButton icon="chevron-down" label="Porta indietro" data-drawing-order="-1" disabled={{ not editable }} />
    <common.Button icon="chevron-up" size="xs" variant="secondary" data-drawing-order="front" disabled={{ not editable }}>Primo piano</common.Button>
    <common.Button icon="chevron-down" size="xs" variant="secondary" data-drawing-order="back" disabled={{ not editable }}>Sfondo</common.Button>
    <common.IconButton icon="grid-2x2" label="Mostra griglia" selected={{ True }} data-drawing-grid />
    <common.Button size="xs" variant="secondary" selected={{ True }} data-snap-grid>Aggancia griglia</common.Button>
    <common.Button size="xs" variant="secondary" selected={{ True }} data-snap-shapes>Aggancia oggetti</common.Button>
  </div>

  <div class="drawing-editor__workspace">
    <div class="drawing-editor__tools" role="toolbar" aria-label="Strumenti di disegno" data-testid="drawing-toolbar">
      <div class="drawing-editor__split">
        <button type="button" class="drawing-editor__tool" aria-pressed="false" data-tool="triangle" data-testid="drawing-tool-triangle">
          <common.Icon name="triangle" size=20 />
          <span class="drawing-editor__tool-label">Triangolo</span>
        </button>
        <common.IconButton icon="chevron-down" label="Varianti del triangolo" id="drawing-triangle-trigger" popovertarget="drawing-triangle-menu" aria-haspopup="menu" aria-expanded="false" data-preset-menu="triangle" disabled={{ not editable }} />
      </div>
      <common.Menu id="drawing-triangle-menu" labelledby="drawing-triangle-trigger">
        <common.MenuItem label="Isoscele" data-drawing-preset="triangle_isosceles" />
        <common.MenuItem label="Equilatero" data-drawing-preset="triangle_equilateral" />
        <common.MenuItem label="Rettangolo · angolo a destra" data-drawing-preset="triangle_right_right" />
        <common.MenuItem label="Rettangolo · angolo a sinistra" data-drawing-preset="triangle_right_left" />
      </common.Menu>
      <div class="drawing-editor__split">
        <button type="button" class="drawing-editor__tool" aria-pressed="false" data-tool="square" data-testid="drawing-tool-square">
          <common.Icon name="square" size=20 />
          <span class="drawing-editor__tool-label">Rettangolo</span>
        </button>
        <common.IconButton icon="chevron-down" label="Varianti del rettangolo" id="drawing-rectangle-trigger" popovertarget="drawing-rectangle-menu" aria-haspopup="menu" aria-expanded="false" data-preset-menu="rectangle" disabled={{ not editable }} />
      </div>
      <common.Menu id="drawing-rectangle-menu" labelledby="drawing-rectangle-trigger">
        <common.MenuItem label="Quadrato" data-drawing-preset="square" />
      </common.Menu>
      <div class="drawing-editor__split">
        <button type="button" class="drawing-editor__tool" aria-pressed="false" data-tool="circle" data-testid="drawing-tool-circle">
          <common.Icon name="circle" size=20 />
          <span class="drawing-editor__tool-label">Cerchio</span>
        </button>
        <common.IconButton icon="chevron-down" label="Varianti del cerchio" id="drawing-circle-trigger" popovertarget="drawing-circle-menu" aria-haspopup="menu" aria-expanded="false" data-preset-menu="circle" disabled={{ not editable }} />
      </div>
      <common.Menu id="drawing-circle-menu" labelledby="drawing-circle-trigger">
        <common.MenuItem label="Ellisse" data-drawing-preset="ellipse" />
      </common.Menu>
      <div class="drawing-editor__split">
        <button type="button" class="drawing-editor__tool" aria-pressed="false" data-tool="polygon" data-testid="drawing-tool-polygon">
          <common.Icon name="pentagon" size=20 />
          <span class="drawing-editor__tool-label">Poligono</span>
        </button>
        <common.IconButton icon="chevron-down" label="Varianti del poligono" id="drawing-polygon-trigger" popovertarget="drawing-polygon-menu" aria-haspopup="menu" aria-expanded="false" data-preset-menu="polygon" disabled={{ not editable }} />
      </div>
      <common.Menu id="drawing-polygon-menu" labelledby="drawing-polygon-trigger">
        <common.MenuItem label="Poligono regolare" data-drawing-preset="regular_polygon" />
      </common.Menu>
      <button type="button" class="drawing-editor__tool" aria-pressed="false" data-tool="line" data-testid="drawing-tool-line">
        <common.Icon name="pen-tool" size=20 />
        <span class="drawing-editor__tool-label">Linea</span>
      </button>
      <button type="button" class="drawing-editor__tool" aria-pressed="false" data-tool="curve" data-testid="drawing-tool-curve">
        <common.Icon name="spline" size=20 />
        <span class="drawing-editor__tool-label">Curva</span>
      </button>
      <button type="button" class="drawing-editor__tool" aria-pressed="false" data-tool="cut" data-testid="drawing-tool-cut">
        <common.Icon name="scissors" size=20 />
        <span class="drawing-editor__tool-label">Taglia</span>
      </button>
    </div>

    <div class="drawing-editor__canvas" data-testid="drawing-canvas">
      <svg class="drawing-editor__artboard" viewBox="0 0 {{ artboard.width if artboard else 640 }} {{ artboard.height if artboard else 480 }}"
           role="img" aria-label="Tavola da disegno" tabindex="0" data-drawing-artboard>
        <defs>
          <pattern id="drawing-grid" width="10" height="10" patternUnits="userSpaceOnUse">
            <path d="M10 0H0V10" fill="none" stroke="var(--line)" stroke-width="1" />
          </pattern>
        </defs>
        <rect class="drawing-editor__plate" x="0" y="0" width="100%" height="100%" />
        <rect class="drawing-editor__grid" x="-100000" y="-100000" width="200000" height="200000" fill="url(#drawing-grid)" />
        {# The scene layer is rebuilt by the client from the document; the
           server-rendered shapes here are the no-JS first paint. #}
        <g class="drawing-editor__scene" data-drawing-scene-layer>
          {% for node in objects %}
          {% if node.kind == "polygon" %}
          <polygon class="drawing-editor__shape{{ ' is-selected' if node.id == (selected.id if selected else None) }}"
                   points="{{ node.points | map('join', ',') | join(' ') }}" fill="{{ node.fill or 'none' }}" stroke="{{ node.stroke or 'none' }}" stroke-width="{{ node.stroke_width }}" stroke-linejoin="miter" />
          {% elif node.kind == "ellipse" %}
          <ellipse class="drawing-editor__shape{{ ' is-selected' if node.id == (selected.id if selected else None) }}"
                   cx="{{ node.cx }}" cy="{{ node.cy }}" rx="{{ node.rx }}" ry="{{ node.ry }}" fill="{{ node.fill or 'none' }}" stroke="{{ node.stroke or 'none' }}" stroke-width="{{ node.stroke_width }}" />
          {% elif node.kind == "path" %}
          <path class="drawing-editor__shape{{ ' is-selected' if node.id == (selected.id if selected else None) }}"
                d="{{ node.d }}" fill="{{ node.fill or 'none' }}" stroke="{{ node.stroke or 'none' }}" stroke-width="{{ node.stroke_width }}" stroke-linejoin="miter" />
          {% endif %}
          {% endfor %}
        </g>
        <g class="drawing-editor__overlay" data-drawing-overlay>
          {% if selected and selected.kind == "polygon" %}
          {% for point in selected.points %}
          <circle class="drawing-editor__handle" cx="{{ point[0] }}" cy="{{ point[1] }}" r="6" />
          {% endfor %}
          {% endif %}
        </g>
      </svg>
    </div>

    <div class="drawing-editor__side">
      <section class="drawing-editor__panel" aria-label="Scena" data-testid="drawing-layers">
        <h3 class="drawing-editor__panel-title">Scena</h3>
        <template data-scene-eye><common.Icon name="eye" size=20 /></template>
        <template data-scene-eye-off><common.Icon name="eye-off" size=20 /></template>
        <template data-scene-arrow><common.Icon name="chevron-down" size=20 /></template>
        <ul class="drawing-editor__layers" role="tree" aria-label="Oggetti della scena">
          {% for node in objects %}
          <li class="drawing-editor__layer{{ ' is-selected' if node.id == (selected.id if selected else None) }}" data-node-id="{{ node.id }}" role="treeitem" aria-level="1" aria-selected="{{ 'true' if node.id == (selected.id if selected else None) else 'false' }}" aria-label="{{ node.name | e }}">
            <button type="button" class="drawing-editor__layer-name" aria-pressed="{{ 'true' if node.id == (selected.id if selected else None) else 'false' }}"
                    data-select-node="{{ node.id }}" data-testid="drawing-layer">{{ node.name | e }}</button>
            <button type="button" class="drawing-editor__visibility" data-node-visible="{{ node.id }}" aria-pressed="{{ 'true' if node.visible else 'false' }}" aria-label="{{ 'Nascondi' if node.visible else 'Mostra' }} {{ node.name | e }}" {% if not editable %}disabled{% endif %}><common.Icon :name="'eye' if node.visible else 'eye-off'" size=20 /></button>
          </li>
          {% else %}
          <li class="drawing-editor__empty hint">Nessun oggetto</li>
          {% endfor %}
        </ul>
      </section>

      <section class="drawing-editor__panel" aria-label="Proprietà" data-testid="drawing-inspector">
        <h3 class="drawing-editor__panel-title">Proprietà</h3>
        <p class="hint" data-drawing-diagnostics role="status" aria-live="polite">Nessuna selezione</p>
        <div class="drawing-editor__field" data-regular-options hidden>
          <label class="drawing-editor__field-label" for="drawing-regular-sides">Lati del poligono</label>
          <input class="drawing-editor__name" type="number" id="drawing-regular-sides" data-regular-sides min="3" max="32" value="6" />
        </div>
        <p class="hint" data-drawing-constraint>Geometria libera</p>
        <common.Button size="xs" variant="secondary" icon="lock-open" data-drawing-unlock disabled={{ not editable }}>Sblocca geometria</common.Button>
        <fieldset class="drawing-editor__geometry" data-ellipse-parameters hidden>
          <legend class="hint">Coordinate locali · unità tavola</legend>
          {% for field, label in [('cx', 'Centro X'), ('cy', 'Centro Y'), ('rx', 'Raggio orizzontale'), ('ry', 'Raggio verticale')] %}
          <label class="drawing-editor__field">
            <span class="drawing-editor__field-label" {% if field == 'rx' %}data-ellipse-radius-label{% endif %}>{{ label }}</span>
            <input class="drawing-editor__name" type="number" step="any" data-ellipse-parameter="{{ field }}" aria-label="{{ label }}" max="100000" min="{{ '0.1' if field in ['rx', 'ry'] else '-100000' }}" />
          </label>
          {% endfor %}
        </fieldset>
        <div class="drawing-editor__palette" role="group" aria-label="Tavolozza">
          <button type="button" class="drawing-editor__chip" data-palette="#ffffff" style="--swatch: #ffffff" aria-label="Bianco"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#000000" style="--swatch: #000000" aria-label="Nero"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#d1402a" style="--swatch: #d1402a" aria-label="Vermiglio"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#d97a26" style="--swatch: #d97a26" aria-label="Arancio"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#e0a327" style="--swatch: #e0a327" aria-label="Ocra"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#8a9a2b" style="--swatch: #8a9a2b" aria-label="Oliva"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#3c7a52" style="--swatch: #3c7a52" aria-label="Bosco"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#1f7a7a" style="--swatch: #1f7a7a" aria-label="Turchese"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#3f7fb0" style="--swatch: #3f7fb0" aria-label="Cielo"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#2c46a8" style="--swatch: #2c46a8" aria-label="Cobalto"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#4a3f8f" style="--swatch: #4a3f8f" aria-label="Indaco"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#7b3f8f" style="--swatch: #7b3f8f" aria-label="Prugna"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#c2506f" style="--swatch: #c2506f" aria-label="Rosa"></button>
          <button type="button" class="drawing-editor__chip" data-palette="#8a5a3c" style="--swatch: #8a5a3c" aria-label="Argilla"></button>
        </div>
        <div class="drawing-editor__field">
          <span class="drawing-editor__field-label">Nome</span>
          <input class="drawing-editor__name" type="text" data-node-name maxlength="120"
                 value="{{ (selected.name if selected else '') | e }}" aria-label="Nome dell’oggetto"
                 disabled={{ not editable }} />
        </div>
        <div class="drawing-editor__field">
          <label class="drawing-editor__field-label" for="drawing-parent">Genitore</label>
          <select class="drawing-editor__name" id="drawing-parent" data-node-parent disabled><option value="">Scena</option></select>
        </div>
        <div class="drawing-editor__field">
          <span class="drawing-editor__field-label">Riempimento</span>
          <span class="drawing-editor__swatch" data-testid="drawing-fill-swatch"
                {% if selected and selected.fill %}style="--swatch: {{ selected.fill }}"{% endif %}></span>
          <input class="drawing-editor__color" type="color" data-style="fill"
                 value="{{ selected.fill if selected and selected.fill else '#e0a327' }}"
                 aria-label="Colore di riempimento" disabled={{ not editable }} />
          <label class="drawing-editor__toggle"><input type="checkbox" data-style="no-fill"
                 {% if not (selected and selected.fill) %}checked{% endif %}
                 aria-label="Nessun riempimento" disabled={{ not editable }} /> Nessuno</label>
        </div>
        <div class="drawing-editor__field">
          <span class="drawing-editor__field-label">Contorno</span>
          <span class="drawing-editor__swatch drawing-editor__swatch--stroke" data-testid="drawing-stroke-swatch"
                {% if selected and selected.stroke %}style="--swatch: {{ selected.stroke }}"{% endif %}></span>
          <input class="drawing-editor__color" type="color" data-style="stroke"
                 value="{{ selected.stroke if selected and selected.stroke else '#17150f' }}"
                 aria-label="Colore del contorno" disabled={{ not editable }} />
          <label class="drawing-editor__toggle"><input type="checkbox" data-style="no-stroke"
                 {% if not (selected and selected.stroke) %}checked{% endif %}
                 aria-label="Nessun contorno" disabled={{ not editable }} /> Nessuno</label>
        </div>
        <div class="drawing-editor__field">
          <span class="drawing-editor__field-label">Spessore</span>
          <input class="drawing-editor__range" type="range" min="0" max="20" step="0.5" data-style="strokeWidth"
                 value="{{ selected.stroke_width if selected else 4 }}" aria-label="Spessore del contorno"
                 disabled={{ not editable }} />
          <span class="drawing-editor__value mono" data-style-value="strokeWidth">{{ selected.stroke_width if selected else 4 }}</span>
        </div>
        <div class="drawing-editor__field">
          <span class="drawing-editor__field-label">Opacità</span>
          <input class="drawing-editor__range" type="range" min="0" max="100" step="1" data-style="opacity"
                 value="{{ (selected.opacity * 100) | round | int if selected else 100 }}" aria-label="Opacità"
                 disabled={{ not editable }} />
          <span class="drawing-editor__value mono" data-style-value="opacity">{{ (selected.opacity * 100) | round | int if selected else 100 }}%</span>
        </div>

        <p class="hint" data-testid="drawing-inspector-hint">Seleziona un oggetto per modificarne colore, spessore e opacità.</p>
      </section>
    </div>
  </div>
</div>
