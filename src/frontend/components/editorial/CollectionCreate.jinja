{#def action, label, hint=None, disabled=False #}
{#css editorial/CollectionCreate.css #}
{# One grid cell shaped like an editorial.Card: a dashed, empty media area where
   the picture would be and the label where the name would be, so it reads as
   the card that is not there yet. The shared creation entry: it owns the
   hover/focus/pressed/disabled states and the draft-first POST, so a page
   passes only the route, the label and the hint. #}
<button type="button" aria-label="{{ label }}"{% if not disabled %} hx-post="{{ action }}" hx-swap="none"{% endif %}{% if disabled %} disabled{% endif %} {{ attrs.render(class="collection-create") }}>
  <span class="collection-create__media" aria-hidden="true">
    <span class="collection-create__plus">+</span>
  </span>
  <span class="collection-create__body">
    <span class="collection-create__label">{{ label }}</span>
    {% if hint %}<span class="collection-create__hint">{{ hint }}</span>{% endif %}
  </span>
</button>
