{#def world_id, base, body, body_html, version, locked=False, can_manage=False, field_name="body", label="Testo Markdown", placeholder=None #}
{#css editorial/DocEdit.css, editorial/Reference.css #}
<div class="docedit" data-doc-edit data-world-id="{{ world_id }}" data-doc-field-name="{{ field_name }}"
     data-autosave-url="/api{{ base }}" data-autosave-version="{{ version }}"
     {% if locked or not can_manage %}data-readonly="true"{% endif %}>
  <textarea class="docedit__source" name="body" data-doc-source hidden>{{ body }}</textarea>
  <div class="docedit__editor" data-doc-editor hidden></div>
  {# `placeholder` is UI copy drawn by CSS over an empty editable body: it never
     enters the Markdown source, the preview or the API, and readers get none. #}
  <div class="docedit__render prose" data-doc-render data-doc-block="body"
       {% if not (locked or not can_manage) %}tabindex="0" aria-label="{{ label }}. Premi Invio per modificare."{% if placeholder %} data-empty-label="{{ placeholder }}"{% endif %}{% endif %}>{{ body_html }}</div>
  <button type="button" hidden data-doc-preview
          hx-post="/worlds/{{ world_id }}/preview"
          hx-include="closest [data-doc-edit]"
          hx-target="[data-doc-render]"
          hx-swap="innerHTML"></button>
  {% if can_manage and not locked %}
    <div class="docedit__actions" data-doc-actions hidden>
      <span class="hint">Ctrl/⌘+Invio mostra il risultato · Esc esce dalla scrittura</span>
    </div>
  {% endif %}
</div>
