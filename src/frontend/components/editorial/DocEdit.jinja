{#def world_id, base, body, body_html, locked=False, can_manage=False #}
<div class="docedit" data-doc-edit data-world-id="{{ world_id }}"
     {% if locked or not can_manage %}data-readonly="true"{% endif %}>
  <form class="docedit__form" hx-post="{{ base }}" hx-swap="none">
    <textarea class="docedit__source" name="body" data-doc-source hidden>{{ body }}</textarea>
    <div class="docedit__editor" data-doc-editor hidden></div>
    <div class="docedit__render prose" data-doc-render tabindex="0">{{ body_html }}</div>
  </form>
  <button type="button" hidden data-doc-preview
          hx-post="/worlds/{{ world_id }}/preview"
          hx-include="closest [data-doc-edit]"
          hx-target="[data-doc-render]"
          hx-swap="innerHTML"></button>
  <div class="docedit__actions" data-doc-actions hidden>
    <button class="btn btn--primary btn--sm" type="button" data-doc-save>Salva</button>
    <button class="btn btn--ghost btn--sm" type="button" data-doc-cancel>Annulla</button>
    <span class="field__hint">Doppio click per scrivere · Ctrl/⌘+Invio per il risultato</span>
  </div>
</div>
