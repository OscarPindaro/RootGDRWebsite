{#def #}
{#css editorial/ReportPanel.css, common/Button.css, common/Dialog.css, common/Icon.css, common/Tooltip.css #}
{#js common/Dialog.js, editorial/ReportPanel.js #}
<common.Dialog title="Segnala un problema" id="report-panel" manual={{ True }}>
  <p class="report-panel__lead">
    Racconta cosa non funziona. La schermata visibile, la pagina intera e l’HTML
    di questa pagina vengono allegati da soli alla bozza.
  </p>
  <label class="report-panel__field">
    <span class="report-panel__label">Cosa non funziona</span>
    <textarea class="report-panel__text" rows="6" data-report-description
              data-dialog-autofocus
              placeholder="Cosa hai fatto, cosa ti aspettavi, cosa è successo."></textarea>
  </label>
  <ul class="report-panel__attachments" data-report-evidence hidden
      aria-label="Allegati della segnalazione"></ul>
  <section class="report-panel__editor" data-report-editor hidden
           aria-label="Annotazione della schermata">
    <div class="report-panel__tools" role="toolbar" aria-label="Strumenti di annotazione">
      <button type="button" class="report-panel__tool" data-report-tool="arrow"
              aria-pressed="true">Freccia</button>
      <button type="button" class="report-panel__tool" data-report-tool="box"
              aria-pressed="false">Riquadro</button>
      <button type="button" class="report-panel__tool" data-report-tool="text"
              aria-pressed="false">Testo</button>
      <button type="button" class="report-panel__tool" data-report-tool="blur"
              aria-pressed="false">Sfoca</button>
    </div>
    <div class="report-panel__colours" data-report-colours role="group"
         aria-label="Colore dell’annotazione"></div>
    <label class="report-panel__field report-panel__field--inline">
      <span class="report-panel__label">Testo da inserire</span>
      <input class="report-panel__input" type="text" maxlength="120"
             data-report-text placeholder="Nota sulla schermata" />
    </label>
    <div class="report-panel__surface">
      <canvas class="report-panel__canvas" data-report-canvas></canvas>
    </div>
    <div class="report-panel__actions">
      <common.Button variant="secondary" size="sm" data-report-undo>
        Annulla ultima
      </common.Button>
      <common.Button variant="primary" size="sm" data-report-save>
        Salva annotazione
      </common.Button>
      <common.Button variant="secondary" size="sm" data-report-editor-close>
        Chiudi
      </common.Button>
    </div>
  </section>
  <section class="report-panel__reproduction" aria-label="Riproduzione del problema">
    <p class="report-panel__label">Riproduzione</p>
    <p class="report-panel__lead report-panel__lead--tight">
      Riproduci il problema e naviga come fai di solito: i passaggi e le chiamate
      restano legati a questa segnalazione.
    </p>
    <div class="report-panel__actions" data-report-reproduce-actions>
      <common.Button variant="secondary" size="sm" data-report-reproduce>
        Riproduci il problema
      </common.Button>
    </div>
    <div class="report-panel__actions" data-report-stop-actions hidden>
      <common.Button variant="danger" size="sm" data-report-stop>
        Interrompi la registrazione
      </common.Button>
    </div>
    <p class="report-panel__recording" data-report-recording role="status" hidden></p>
  </section>
  <section class="report-panel__submit" aria-label="Invio della segnalazione">
    <div class="report-panel__actions" data-report-submit-actions>
      <common.Button variant="primary" size="sm" data-report-submit>
        Invia la segnalazione
      </common.Button>
    </div>
    <p class="report-panel__ticket" data-report-ticket role="status" hidden></p>
  </section>
  <p class="report-panel__status" data-report-status role="status"></p>
  <common.Button variant="secondary" size="sm" data-report-recapture>
    Riprendi schermata
  </common.Button>
</common.Dialog>
