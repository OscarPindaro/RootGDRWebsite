{#def world, world_context, nav, npc, can_manage, crumbs, pages=None, body_html=None, links=None, current_user=None #}
{#css common/Button.css, common/Pill.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, editorial/DocEdit.css, editorial/DocIdentity.css #}
<layout.Page :title="npc.name" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="npc">
  <editorial.Crumbs :items="crumbs" />

  <editorial.Docbar
    :base="'/worlds/' ~ world.id ~ '/npcs/' ~ npc.id"
    eyebrow="NPC"
    :locked="npc.locked"
    :is_draft="npc.is_draft"
    :can_manage="can_manage">
    <span class="pill pill--plain">NPC del Master</span>
    <button class="btn btn--ghost btn--sm" type="button" data-testid="delete-npc"
            hx-delete="/worlds/{{ world.id }}/npcs/{{ npc.id }}"
            hx-confirm="Eliminare {{ npc.name }}?" hx-swap="none">Elimina</button>
  </editorial.Docbar>

  <div class="docpage">
    <div>
      <div class="document">
        <div class="document__head">
          <div class="document__face">
            <editorial.Face :tint="npc.tint" :animal="npc.animal" :image_url="npc.image_url" />
          </div>
          <editorial.DocIdentity :base="'/worlds/' ~ world.id ~ '/npcs/' ~ npc.id"
            :can_manage="can_manage" :locked="npc.locked" :version="npc.version">
            <h1 class="display" data-doc-field="name">{{ npc.name }}</h1>
            <p class="card__title" data-doc-field="title"
               {% if not npc.title %}data-empty="true"{% endif %}>{{ npc.title or '' }}</p>
            <p class="lede" data-doc-field="short_description"
               {% if not npc.short_description %}data-empty="true"{% endif %}>{{ npc.short_description or '' }}</p>
          </editorial.DocIdentity>
        </div>
        <div class="document__page">
          <span class="eyebrow">Descrizione</span>
          <editorial.DocEdit world_id={{ world.id }}
            :base="'/worlds/' ~ world.id ~ '/npcs/' ~ npc.id"
            :body="npc.body" :body_html="body_html"
            :locked="npc.locked" :version="npc.version" :can_manage="can_manage" />
        </div>
      </div>
    </div>
    {% if links %}<editorial.Links :groups="links" />{% endif %}
  </div>
</layout.Page>
