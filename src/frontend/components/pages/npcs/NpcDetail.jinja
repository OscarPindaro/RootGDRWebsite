{#def world, world_context, nav, npc, can_manage, crumbs, animals, tints, pages=None, short_html=None, body_html=None, links=None, current_user=None, auto_edit=False #}
{#css common/Button.css, common/Pill.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/ChoiceGrid.css, editorial/ImageEditor.css, editorial/DocEdit.css, editorial/DocIdentity.css, editorial/DocSummary.css, common/VStack.css, common/Tooltip.css, common/SaveIndicator.css, common/HStack.css, common/Grid.css, common/Dialog.css, editorial/Docbar.css, common/ConfirmDialog.css, layout/Rail.css, layout/Topbar.css, layout/Palette.css #}
<layout.Page :title="npc.name" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="npc">
  <editorial.Crumbs :items="crumbs" />

  <editorial.Docbar
    :base="'/worlds/' ~ world.id ~ '/npcs/' ~ npc.id"
    eyebrow="NPC"
    owner_label="NPC del Master"
    :locked="npc.locked"
    :is_draft="npc.is_draft"
    :can_manage="can_manage" />

  <common.Grid document>
    <div>
      <div class="document">
        <div class="document__head">
          <div class="document__face document__face--editor">
            <editorial.ImageEditor :world_id="world.id" owner_kind="npc" :owner_id="npc.id"
              :upload_url="'/api/worlds/' ~ world.id ~ '/npcs/' ~ npc.id ~ '/image'"
              :fallback_action="'/worlds/' ~ world.id ~ '/npcs/' ~ npc.id ~ '/image'"
              :image_url="npc.image_url" :can_manage="can_manage" :locked="npc.locked"
              :version="npc.version" :tint="npc.tint" :symbol="npc.animal"
              symbol_name="animal" symbol_kind="emoji" :symbol_options="animals" :tints="tints"
              :label="'Immagine di ' ~ npc.name" />
          </div>
          <div class="document__id">
            <editorial.DocIdentity :base="'/worlds/' ~ world.id ~ '/npcs/' ~ npc.id"
              :can_manage="can_manage" :locked="npc.locked" :version="npc.version" :auto_edit="auto_edit">
              <span class="eyebrow">Nome</span>
              <h1 class="display" data-doc-field="name" data-doc-block="name">{{ npc.name }}</h1>
              <span class="eyebrow">Titolo</span>
              <p class="card__title" data-doc-field="title" data-doc-block="title"
                 {% if not npc.title %}data-empty="true"{% endif %}>{{ npc.title or '' }}</p>
              <editorial.DocSummary :world_id="world.id" :base="'/worlds/' ~ world.id ~ '/npcs/' ~ npc.id"
                :value="npc.short_description" :value_html="short_html" :version="npc.version"
                :can_manage="can_manage" :locked="npc.locked" />
            </editorial.DocIdentity>
            <div class="document__page">
              <span class="eyebrow">Descrizione</span>
              <editorial.DocEdit world_id={{ world.id }}
                :base="'/worlds/' ~ world.id ~ '/npcs/' ~ npc.id"
                :body="npc.body" :body_html="body_html"
                :locked="npc.locked" :version="npc.version" :can_manage="can_manage" />
            </div>
          </div>
        </div>
      </div>
    </div>
    {% if links %}
    <common.VStack element="aside">
      <editorial.Links :groups="links" />
    </common.VStack>
    {% endif %}
  </common.Grid>
</layout.Page>
