{#def world, world_context, nav, cards, crumbs, can_manage=False, pages=None, drafts=None, current_user=None #}
{#css common/Button.css, common/Grid.css, common/Tooltip.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css #}
{% set eyebrow_text = (cards | length) ~ (' scheda' if (cards | length) == 1 else ' schede') %}
<layout.Page title="NPC" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="npc">  <editorial.Masthead
    title="NPC"
    :eyebrow="eyebrow_text"
    lede="Schede scritte e mantenute dal Master. I giocatori le leggono; qui stanno anche i segreti che non devono ancora sapere."
    :crumbs="crumbs">
    {% if can_manage %}
    <common.Tooltip text="Nuovo NPC">
      <common.Button :hx-post="'/worlds/' ~ world.id ~ '/npcs/new'" hx-swap="none" variant="primary" size="sm" icon="plus" icon_only label="Nuovo NPC" data-testid="create-npc" />
    </common.Tooltip>
    {% endif %}
  </editorial.Masthead>

  {% if cards %}
  <common.Grid min="card" gap=5>
    {% for card in cards %}<editorial.Card :item="card" />{% endfor %}
  </common.Grid>
  {% else %}
  <div class="empty">Nessun NPC. Creane uno per cominciare.</div>
  {% endif %}

{% if drafts %}
<section class="section">
  <editorial.SectionHead title="Bozze" eyebrow="Non ancora pubblicate" />
  <common.Grid min="card" gap=5>
    {% for card in drafts %}<editorial.Card :item="card" />{% endfor %}
  </common.Grid>
</section>
{% endif %}
</layout.Page>
