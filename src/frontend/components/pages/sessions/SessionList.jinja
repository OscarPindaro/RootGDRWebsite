{#def world, world_context, nav, rows, can_manage=False, crumbs, pages=None, drafts=None, current_user=None #}
{#css common/Button.css, common/Tooltip.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/EmptyState.css, common/SaveIndicator.css, common/Pill.css, editorial/Ledger.css, editorial/Row.css, layout/Rail.css, layout/Topbar.css, layout/Palette.css #}
{% set count = rows | length %}
{% set eyebrow_text = count ~ (' sessione' if count == 1 else ' sessioni') %}
<layout.Page title="Sessioni" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="sessioni">
  <editorial.Masthead
    title="Registro delle sessioni"
    :eyebrow="eyebrow_text"
    lede="Dalla più recente. Ogni sessione ha un colore che la segue anche nelle timeline e nelle schede dei personaggi."
    :crumbs="crumbs">
    {% if can_manage %}
    <common.IconButton icon="plus" label="Nuova sessione" variant="primary" size="sm" :hx-post="'/worlds/' ~ world.id ~ '/sessions/new'" hx-swap="none" data-testid="create-session" />
    {% endif %}
  </editorial.Masthead>

  {% if rows %}
  <editorial.Ledger :columns="['N°', 'Data', 'Sessione', '']">
    {% for number, session in rows %}
    <editorial.LedgerRow
      :href="'/worlds/' ~ world.id ~ '/sessions/' ~ session.id"
      :tint="session.tint"
      :number="'%02d' | format(number)"
      sdot
      :meta="session.in_world_date"
      :meta_extra="session.real_date"
      :title="session.title"
      :summary="session.short_description"
      :tag="'Bozza' if session.is_draft else None" />
    {% endfor %}
  </editorial.Ledger>
  {% else %}
  <common.EmptyState icon="calendar" title="Nessuna sessione registrata" />
  {% endif %}

{% if drafts %}
<section class="section">
  <editorial.SectionHead title="Bozze" eyebrow="Non ancora pubblicate" />
  <editorial.RowList>
    {% for draft in drafts %}
    <editorial.Row :href="'/worlds/' ~ world.id ~ '/sessions/' ~ draft.id" :tint="draft.tint"
      :name="draft.title" :description="draft.in_world_date" draft />
    {% endfor %}
  </editorial.RowList>
</section>
{% endif %}
</layout.Page>
