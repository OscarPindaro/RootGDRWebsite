{#def drawings, current_user=None #}
{#css common/Button.css, common/EmptyState.css, common/Icon.css, common/Tooltip.css, editorial/Crumbs.css, editorial/Ledger.css, editorial/Masthead.css, editorial/Row.css, layout/Page.css, common/Alert.css, common/Avatar.css, common/Mark.css, common/Menu.css, common/RequestFallback.css, common/SaveIndicator.css, layout/Palette.css, layout/Rail.css, layout/Topbar.css, layout/UserMenu.css #}
{% set count = drawings | length %}
{% set eyebrow_text = "Archivio · " ~ count ~ (" disegno" if count == 1 else " disegni") %}
<layout.Page title="Disegni" current_user={{ current_user }} active="disegni" wide={{ True }}>
  <editorial.Masthead
    title="Disegni"
    :eyebrow="eyebrow_text"
    lede="Tavole geometriche originali: personaggi, oggetti e scenari composti da forme piene e contorni netti. Solo chi amministra può crearle e modificarle.">
    <common.IconButton icon="plus" label="Nuovo disegno" variant="primary" size="sm"
                       hx-post="/drawings/new" hx-swap="none" data-testid="create-drawing" />
  </editorial.Masthead>

  {% if drawings %}
  <editorial.Ledger :columns="['Pos.', 'Nome', 'Forme', 'Aggiornato']">
    {% for drawing in drawings %}
    <editorial.LedgerRow
      :href="'/drawings/' ~ drawing.id"
      :number="'%02d' | format(loop.index)"
      :title="drawing.title"
      :summary="drawing.node_count ~ (' forma' if drawing.node_count == 1 else ' forme')"
      :tag="drawing.updated_at | time" />
    {% endfor %}
  </editorial.Ledger>
  {% else %}
  <common.EmptyState icon="spline" title="Nessun disegno"
                     description="Crea un disegno per cominciare a comporre una tavola geometrica." />
  {% endif %}
</layout.Page>
