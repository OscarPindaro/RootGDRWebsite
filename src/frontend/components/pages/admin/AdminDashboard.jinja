{#def users, invitations, current_user=None #}
{#css common/Alert.css, common/Dialog.css, common/Field.css, pages/admin/InviteDialog.css, common/ConfirmDialog.css, common/HStack.css, common/Avatar.css, common/Button.css, common/EmptyState.css, common/Menu.css, common/Pill.css, common/SaveIndicator.css, common/Table.css, common/Tooltip.css, common/VStack.css, layout/Page.css, layout/Palette.css, layout/Rail.css, layout/Topbar.css, layout/UserMenu.css, pages/admin/UsersTable.css, common/RequestFallback.css, common/Icon.css, common/Mark.css, editorial/Crumbs.css, editorial/Masthead.css, editorial/SectionHead.css #}
{#js common/Dialog.js #}
{# The administration surface: the masthead carries the page action, the two
   sections carry a heading each, and the invitation table is swapped in place.
   The swap targets keep their heading and can receive focus, so a partial
   replacement never strands the reader. The invite dialog and the revoke
   confirmation arrive through htmx, so their stylesheets are declared here as
   well as in the fragments. #}
<layout.Page title="Utenti" current_user={{ current_user }} active="admin-users">
  <editorial.Masthead
    title="Utenti"
    eyebrow="Amministrazione"
    lede="Gli account registrati in questa istanza e gli inviti che attendono una risposta.">
    <common.Button variant="primary" size="md" icon="user-plus"
                   hx-get="/admin/users/invite"
                   hx-target="#invite-dialog"
                   hx-swap="innerHTML"
                   data-testid="invite-user">Invita utente</common.Button>
  </editorial.Masthead>

  <common.VStack gap=8>
    <section>
      <editorial.SectionHead title="Utenti" eyebrow="Account registrati" />
      <div id="users-table">
        <pages.admin.UsersTable users={{ users }} />
      </div>
    </section>

    <section>
      <editorial.SectionHead title="Inviti" eyebrow="In sospeso e accettati" />
      <div id="invitations-table" role="region" aria-label="Inviti" tabindex="-1">
        <pages.admin.InvitationsTable invitations={{ invitations }} />
      </div>
    </section>
  </common.VStack>

  <div id="invite-dialog"></div>
  <div id="confirm-dialog"></div>
</layout.Page>
