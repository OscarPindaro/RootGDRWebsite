{#def users, invitations, current_user=None #}
{#css common/Dialog.css, common/Alert.css, common/Field.css, pages/admin/InviteDialog.css, common/Avatar.css, common/Button.css, common/Menu.css, common/Pill.css, common/Table.css, common/Tooltip.css, layout/Page.css, layout/Sidebar.css, layout/UserMenu.css, common/SaveIndicator.css, pages/admin/AdminDashboard.css, layout/Rail.css, layout/Topbar.css, layout/Palette.css #}
{#js common/Dialog.js #}
<layout.Page title="Utenti" current_user={{ current_user }} active="admin-users">
  <div class="admin-dashboard">
    <header class="admin-header">
      <h1>Utenti</h1>
      <common.Button variant="primary" size="md"
        hx-get="/admin/users/invite"
        hx-target="#invite-dialog"
        hx-swap="innerHTML">
        <common.Icon name="user-plus" size=16 />
        Invita utente
      </common.Button>
    </header>

    <section class="admin-section">
      <h2 class="admin-section-title">Utenti</h2>
      <pages.admin.UsersTable users={{ users }} />
    </section>

    <section class="admin-section">
      <h2 class="admin-section-title">Inviti in sospeso</h2>
      <div id="invitations-table">
        <pages.admin.InvitationsTable invitations={{ invitations }} />
      </div>
    </section>

    <div id="invite-dialog"></div>
    <div id="confirm-dialog"></div>
  </div>
</layout.Page>
