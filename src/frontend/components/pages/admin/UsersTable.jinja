{#def users #}
{#css common/Pill.css, common/Table.css #}
<common.Table headers={{ ["Nome", "Email", "Ruolo", "Stato"] }}>
  {% for user in users %}
  <tr>
    <td>{{ user.name }}</td>
    <td>{{ user.email }}</td>
    <td>
      {% if user.role == 'admin' %}
      <common.Pill variant="role-admin">Amministratore</common.Pill>
      {% else %}
      <common.Pill variant="role-member">Membro</common.Pill>
      {% endif %}
    </td>
    <td>
      {% if user.is_active %}
      <common.Pill variant="success">Attivo</common.Pill>
      {% else %}
      <common.Pill variant="danger">Disattivato</common.Pill>
      {% endif %}
    </td>
  </tr>
  {% endfor %}
</common.Table>
