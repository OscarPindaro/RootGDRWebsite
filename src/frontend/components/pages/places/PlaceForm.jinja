{#def world, world_context, nav, place, shapes, tints, crumbs, pages=None, current_user=None #}
{#css common/Button.css, common/Field.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css #}
{% if place %}
{% set title = "Modifica Luogo" %}
{% set action = "/worlds/" ~ world.id ~ "/luoghi/" ~ place.id %}
{% else %}
{% set title = "Nuovo Luogo" %}
{% set action = "/worlds/" ~ world.id ~ "/luoghi/new" %}
{% endif %}
<layout.Page :title="title" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="luoghi">
  <editorial.Masthead :title="title"
    eyebrow="Scheda"
    lede="La radura ha una forma e una tinta, oppure un'immagine caricata."
    :crumbs="crumbs" />

  <form class="form" hx-post="{{ action }}" hx-swap="none">
    <common.Field label="Nome completo" name="name" type="text" required maxlength=255
                  :value="place.name if place else None" />
    <common.Field label="Descrizione breve" name="short_description" type="text" maxlength=1000
                  :value="place.short_description if place else None" />
    <common.Field label="Forma" name="shape" type="select" :options="shapes"
                  :value="place.shape if place else 'cerchio'" />
    <common.Field label="Tinta della scheda" name="tint" type="select" :options="tints"
                  :value="place.tint if place else 'p1'" />
    <common.MarkdownField label="Descrizione lunga" name="body"
                  helper="Markdown. Puoi usare @[Nome] per collegare altri contenuti."
                  :world_id="world.id"
                  :value="place.body if place else ''" />
    <div class="row-inline">
      <common.Button type="submit" variant="primary" size="md">Salva</common.Button>
      {% if place %}
      <a class="btn btn--ghost" href="/worlds/{{ world.id }}/luoghi/{{ place.id }}">Annulla</a>
      {% else %}
      <a class="btn btn--ghost" href="/worlds/{{ world.id }}/luoghi">Annulla</a>
      {% endif %}
    </div>
  </form>
</layout.Page>
