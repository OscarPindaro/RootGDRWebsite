{#def world, world_context, nav, places, current_place_id=None, can_manage=False, crumbs, pages=None, drafts=None, current_user=None #}
{#css common/Button.css, common/Grid.css, common/Tooltip.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/EmptyState.css, common/SaveIndicator.css, common/Pill.css, editorial/EntityCard.css, editorial/Row.css #}
{% set eyebrow_text = (places | length) ~ (' luogo' if (places | length) == 1 else ' luoghi') %}
<layout.Page title="Luoghi" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="luoghi">
  <editorial.Masthead
    title="Atlante dei luoghi"
    :eyebrow="eyebrow_text"
    lede="Ogni radura ha un simbolo e un colore, così si riconosce a colpo d'occhio in una mappa, in una sessione o in un elenco."
    :crumbs="crumbs">
    {% if can_manage %}
    <common.IconButton icon="plus" label="Nuovo luogo" variant="primary" size="sm" :hx-post="'/worlds/' ~ world.id ~ '/places/new'" hx-swap="none" data-testid="create-place" />
    {% endif %}
  </editorial.Masthead>

  {% if places %}
  {% set featured = places[0] %}
  <a class="feature" href="/worlds/{{ world.id }}/places/{{ featured.id }}" style="margin-bottom: 2.5rem">
    <div class="feature__media" style="display: grid; place-items: center; background: var(--surface)">
      {% if featured.image_url %}
      <img src="{{ featured.image_url }}" alt="">
      {% else %}
      <editorial.Plogo :tint="featured.tint" :shape="featured.shape" class="plogo plogo--lg" />
      {% endif %}
    </div>
    <div class="feature__body">
      <span class="eyebrow">{{ 'Scena corrente' if featured.id == current_place_id else 'In evidenza' }}</span>
      <h2 class="feature__title">{{ featured.name }}</h2>
      <p class="lede">{{ featured.short_description }}</p>
    </div>
  </a>

  {% if (places | length) > 1 %}
  <editorial.SectionHead title="Le altre radure" eyebrow="Resto dell'atlante" />
  <editorial.RowList>
    {% for place in places[1:] %}
    <editorial.Row :href="'/worlds/' ~ world.id ~ '/places/' ~ place.id" :tint="place.tint"
      :name="place.name" :description="place.short_description"
      :meta="'Scena corrente' if place.id == current_place_id else None">
      <editorial.Plogo :tint="place.tint" :shape="place.shape" />
    </editorial.Row>
    {% endfor %}
  </editorial.RowList>
  {% endif %}
  {% else %}
  <common.EmptyState icon="map-pin" title="Nessun luogo" description="L'atlante è vuoto." />
  {% endif %}

{% if drafts %}
<section class="section">
  <editorial.SectionHead title="Bozze" eyebrow="Non ancora pubblicate" />
  <common.Grid min="card" gap=5>
    {% for card in drafts %}<editorial.EntityCard :item="card" />{% endfor %}
  </common.Grid>
</section>
{% endif %}
</layout.Page>
