{#def world, world_context, nav, place, is_current=False, can_manage=False, crumbs, pages=None, body_html=None, links=None, current_user=None #}
{#css common/Button.css, common/Pill.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css #}
<layout.Page :title="place.name" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="luoghi">
  <editorial.Crumbs :items="crumbs" />

  <editorial.Docbar
    :base="'/worlds/' ~ world.id ~ '/luoghi/' ~ place.id"
    eyebrow="Luogo"
    :locked="place.locked"
    :is_draft="place.is_draft"
    :can_manage="can_manage">
    {% if is_current %}<span class="pill pill--forest">Scena corrente</span>{% endif %}
    {% if is_current %}
    <button class="btn btn--ghost btn--sm" type="button"
            hx-post="/worlds/{{ world.id }}/luoghi/current/clear" hx-swap="none">Rimuovi scena corrente</button>
    {% else %}
    <button class="btn btn--ghost btn--sm" type="button"
            hx-post="/worlds/{{ world.id }}/luoghi/{{ place.id }}/current" hx-swap="none">Scena corrente</button>
    {% endif %}
    <a class="btn btn--primary btn--sm" href="/worlds/{{ world.id }}/luoghi/{{ place.id }}/edit">Modifica</a>
    <button class="btn btn--ghost btn--sm" type="button"
            hx-delete="/worlds/{{ world.id }}/luoghi/{{ place.id }}"
            hx-confirm="Eliminare {{ place.name }}?" hx-swap="none">Elimina</button>
  </editorial.Docbar>

  <div class="docpage">
    <div>
      <div class="document">
        <div class="document__head">
          <div class="document__face">
            <editorial.Face :tint="place.tint" :shape="place.shape" :image_url="place.image_url" />
          </div>
          <div class="document__id">
            <h1 class="display">{{ place.name }}</h1>
            {% if place.short_description %}<p class="lede">{{ place.short_description }}</p>{% endif %}
          </div>
        </div>
        <div class="document__page">
          <span class="eyebrow">Descrizione</span>
          <div class="prose">{{ body_html }}</div>
        </div>
      </div>
    </div>
    {% if links %}<editorial.Links :groups="links" />{% endif %}
  </div>
</layout.Page>
