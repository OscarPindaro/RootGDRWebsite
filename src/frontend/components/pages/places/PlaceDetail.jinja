{#def world, world_context, nav, place, shapes, tints, is_current=False, can_manage=False, crumbs, pages=None, short_html=None, body_html=None, links=None, current_user=None, auto_edit=False #}
{#css editorial/Document.css, common/Button.css, common/Pill.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/ChoiceGrid.css, editorial/ImageEditor.css, editorial/DocEdit.css, editorial/DocIdentity.css, editorial/DocSummary.css, common/VStack.css, common/Tooltip.css, common/SaveIndicator.css, common/HStack.css, common/Grid.css, common/Dialog.css, editorial/Docbar.css, common/ConfirmDialog.css, layout/Rail.css, layout/Topbar.css, layout/Palette.css, common/Alert.css, common/RequestFallback.css, common/Icon.css, common/Mark.css, editorial/Crumbs.css, editorial/Face.css, editorial/Links.css #}
<layout.Page :title="place.name" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="luoghi">
  <editorial.Crumbs :items="crumbs" />

  <editorial.Docbar
    :base="'/worlds/' ~ world.id ~ '/places/' ~ place.id"
    eyebrow="Luogo"
    :locked="place.locked"
    :is_draft="place.is_draft"
    :can_manage="can_manage"
    :badge="'Scena corrente' if is_current else None">
    {% if is_current %}
    <common.IconButton icon="map-pin-off" label="Rimuovi scena corrente"
            data-testid="document-current-clear"
            :hx-post="'/worlds/' ~ world.id ~ '/places/current/clear'" hx-swap="none" />
    {% else %}
    <common.IconButton icon="map-pin" label="Imposta come scena corrente"
            data-testid="document-current-set"
            :hx-post="'/worlds/' ~ world.id ~ '/places/' ~ place.id ~ '/current'" hx-swap="none" />
    {% endif %}
  </editorial.Docbar>

  <common.Grid document>
    <div>
      <div class="document">
        <div class="document__head">
          <div class="document__face document__face--editor">
            <editorial.ImageEditor :world_id="world.id" owner_kind="place" :owner_id="place.id"
              :upload_url="'/api/worlds/' ~ world.id ~ '/places/' ~ place.id ~ '/image'"
              :fallback_action="'/worlds/' ~ world.id ~ '/places/' ~ place.id ~ '/image'"
              :image_url="place.image_url" :can_manage="can_manage" :locked="place.locked"
              :version="place.version" :tint="place.tint" :symbol="place.shape"
              symbol_name="shape" symbol_kind="shape" :symbol_options="shapes" :tints="tints"
              :label="'Immagine di ' ~ place.name" />
          </div>
          <div class="document__id">
            <editorial.DocIdentity :base="'/worlds/' ~ world.id ~ '/places/' ~ place.id"
              :can_manage="can_manage" :locked="place.locked" :version="place.version" :auto_edit="auto_edit">
              <h1 class="display" data-doc-field="name" data-doc-block="name">{{ place.name }}</h1>
              <editorial.DocSummary :world_id="world.id" :base="'/worlds/' ~ world.id ~ '/places/' ~ place.id"
                :value="place.short_description" :value_html="short_html" :version="place.version"
                :can_manage="can_manage" :locked="place.locked" />
            </editorial.DocIdentity>
            <div class="document__page">
              <span class="eyebrow">Descrizione</span>
              <editorial.DocEdit world_id={{ world.id }}
                :base="'/worlds/' ~ world.id ~ '/places/' ~ place.id"
                :body="place.body" :body_html="body_html"
                :locked="place.locked" :version="place.version" :can_manage="can_manage"
                placeholder="Aggiungi una descrizione…" />
            </div>
          </div>
        </div>
      </div>
    </div>
    {% if links %}
    <common.VStack element="aside">
      <editorial.Links :groups="links" />
    </common.VStack>
    {% endif %}
  </common.Grid>
</layout.Page>
