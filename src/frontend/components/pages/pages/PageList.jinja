{#def world, world_context, nav, pages, rows, can_manage=False, crumbs, drafts=None, current_user=None #}
{#css common/Button.css, common/Tooltip.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/EmptyState.css, common/SaveIndicator.css, common/Pill.css, editorial/Ledger.css, editorial/Row.css, layout/Rail.css, layout/Topbar.css, layout/Palette.css, common/Alert.css, common/RequestFallback.css #}
{% set count = rows | length %}
{% set eyebrow_text = count ~ (' pagina' if count == 1 else ' pagine') %}
<layout.Page title="Pagine" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="pagine">
  <editorial.Masthead
    title="Pagine di riferimento"
    :eyebrow="eyebrow_text"
    lede="Materiale statico: regole di casa, fazioni, calendario e storia. L'ordine è quello con cui compaiono nella navigazione."
    :crumbs="crumbs">
    {% if can_manage %}
    <common.IconButton icon="plus" label="Nuova pagina" variant="primary" size="sm" :hx-post="'/worlds/' ~ world.id ~ '/pages/new'" hx-swap="none" data-testid="create-page" />
    {% endif %}
  </editorial.Masthead>

  {% if rows %}
  <editorial.Ledger :columns="['Pos.', 'Slug', 'Titolo', 'Aggiornata']">
    {% for number, page in rows %}
    <editorial.LedgerRow
      :href="'/worlds/' ~ world.id ~ '/pages/' ~ page.slug"
      :tint="page.tint"
      :number="'%02d' | format(page.menu_position)"
      :meta="page.slug"
      :title="page.title"
      :summary="page.short_description"
      :tag="page.updated_at | time" />
    {% endfor %}
  </editorial.Ledger>
  {% else %}
  <common.EmptyState icon="file-text" title="Nessuna pagina di riferimento" />
  {% endif %}

{% if drafts %}
<section class="section">
  <editorial.SectionHead title="Bozze" eyebrow="Non ancora pubblicate" />
  <editorial.RowList>
    {% for draft in drafts %}
    <editorial.Row :href="'/worlds/' ~ world.id ~ '/pages/' ~ draft.slug" :tint="draft.tint"
      :name="draft.title" :description="draft.slug" draft />
    {% endfor %}
  </editorial.RowList>
</section>
{% endif %}
</layout.Page>
