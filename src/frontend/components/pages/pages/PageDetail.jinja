{#def world, world_context, nav, pages, page, others, can_manage=False, crumbs, body_html=None, links=None, current_user=None #}
{#css common/Button.css, common/Pill.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, editorial/DocEdit.css, editorial/DocIdentity.css #}
<layout.Page :title="page.title" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="pagine">
  <editorial.Crumbs :items="crumbs" />

  <editorial.Docbar
    :base="'/worlds/' ~ world.id ~ '/pages/' ~ page.id"
    :eyebrow="'Pagina · posizione ' ~ '%02d'|format(page.menu_position) ~ ' · slug ' ~ page.slug"
    :locked="page.locked"
    :is_draft="page.is_draft"
    :can_manage="can_manage">
    <button class="btn btn--ghost btn--sm" type="button" data-testid="delete-page"
            hx-delete="/worlds/{{ world.id }}/pages/{{ page.id }}"
            hx-confirm="Eliminare «{{ page.title }}»?" hx-swap="none">Elimina</button>
  </editorial.Docbar>

  <editorial.DocIdentity :base="'/worlds/' ~ world.id ~ '/pages/' ~ page.id"
    :can_manage="can_manage" :locked="page.locked" :version="page.version">
    <h1 class="display" data-doc-field="title">{{ page.title }}</h1>
    <p class="lede" data-doc-field="short_description"
       {% if not page.short_description %}data-empty="true"{% endif %}>{{ page.short_description or '' }}</p>
  </editorial.DocIdentity>

  <div class="article">
    <article>
      <editorial.DocEdit world_id={{ world.id }}
        :base="'/worlds/' ~ world.id ~ '/pages/' ~ page.id"
        :body="page.body" :body_html="body_html"
        :locked="page.locked" :version="page.version" :can_manage="can_manage" />
    </article>
    <aside class="stack">
      <div class="toc">
        <div class="toc__label">Altre pagine</div>
        {% for other in others %}
        <a href="/worlds/{{ world.id }}/pages/{{ other.slug }}">{{ other.title }}</a>
        {% endfor %}
      </div>
    </aside>
  </div>
    {% if links %}<editorial.Links :groups="links" />{% endif %}
</layout.Page>
