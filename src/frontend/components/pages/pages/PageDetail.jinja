{#def world, world_context, nav, pages, page, others, can_manage=False, crumbs, short_html=None, body_html=None, links=None, current_user=None, metadata=None, auto_edit=False #}
{#css common/Button.css, common/Pill.css, common/VStack.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, editorial/DocEdit.css, editorial/DocIdentity.css, editorial/DocSummary.css, editorial/Metadata.css, common/SaveIndicator.css, common/Grid.css, editorial/Docbar.css, common/ConfirmDialog.css, layout/Rail.css, layout/Topbar.css, layout/Palette.css, common/Alert.css, common/RequestFallback.css, common/Icon.css, common/Mark.css, editorial/Crumbs.css, editorial/Links.css, pages/pages/PageDetail.css #}
<layout.Page :title="page.title" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="pagine">
  <editorial.Crumbs :items="crumbs" />

  <editorial.Docbar
    :base="'/worlds/' ~ world.id ~ '/pages/' ~ page.id"
    :eyebrow="'Pagina · posizione ' ~ '%02d'|format(page.menu_position) ~ ' · slug ' ~ page.slug"
    :locked="page.locked"
    :is_draft="page.is_draft"
    :can_manage="can_manage" />

  <editorial.DocIdentity :base="'/worlds/' ~ world.id ~ '/pages/' ~ page.id"
    :can_manage="can_manage" :locked="page.locked" :version="page.version" :auto_edit="auto_edit">
    <span class="eyebrow">Titolo</span>
    <h1 class="display" data-doc-field="title" data-doc-block="title">{{ page.title }}</h1>
    <editorial.DocSummary :world_id="world.id" :base="'/worlds/' ~ world.id ~ '/pages/' ~ page.id"
      :value="page.short_description" :value_html="short_html" :version="page.version"
      :can_manage="can_manage" :locked="page.locked" />
  </editorial.DocIdentity>
  <editorial.Metadata :fields="metadata" :base="'/worlds/' ~ world.id ~ '/pages/' ~ page.id" :version="page.version" :can_manage="can_manage" :locked="page.locked" :canonical_prefix="'/worlds/' ~ world.id ~ '/pages'" />

  <common.Grid document>
    <article>
      <editorial.DocEdit world_id={{ world.id }}
        :base="'/worlds/' ~ world.id ~ '/pages/' ~ page.id"
        :body="page.body" :body_html="body_html"
        :locked="page.locked" :version="page.version" :can_manage="can_manage" />
    </article>
    <common.VStack element="aside">
      <div class="toc">
        <div class="toc__label">Altre pagine</div>
        {% for other in others %}
        <a href="/worlds/{{ world.id }}/pages/{{ other.slug }}">{{ other.title }}</a>
        {% endfor %}
      </div>
      {% if links %}<editorial.Links :groups="links" />{% endif %}
    </common.VStack>
  </common.Grid>
</layout.Page>
