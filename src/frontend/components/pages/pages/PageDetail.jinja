{#def world, world_context, nav, pages, page, others, can_manage=False, crumbs, current_user=None #}
{#css common/Button.css, common/Pill.css, layout/UserMenu.css #}
<layout.Page :title="page.title" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="pagine">
  <editorial.Masthead
    :title="page.title"
    :eyebrow="'Pagina · posizione ' ~ '%02d' | format(page.menu_position) ~ ' · slug ' ~ page.slug"
    :lede="page.short_description"
    :crumbs="crumbs">
    {% if can_manage %}
    <div class="masthead__actions">
      <a class="btn btn--ghost btn--sm" href="/worlds/{{ world.id }}/pagine/{{ page.id }}/edit">Modifica</a>
      <button class="btn btn--ghost btn--sm" type="button"
              hx-delete="/worlds/{{ world.id }}/pagine/{{ page.id }}"
              hx-confirm="Eliminare «{{ page.title }}»?" hx-swap="none">Elimina</button>
    </div>
    {% endif %}
  </editorial.Masthead>

  <div class="article">
    <article class="prose">
      {{ page.body | markdown }}
    </article>
    <aside class="stack">
      <div class="toc">
        <div class="toc__label">Altre pagine</div>
        {% for other in others %}
        <a href="/worlds/{{ world.id }}/pagine/{{ other.slug }}">{{ other.title }}</a>
        {% endfor %}
      </div>
    </aside>
  </div>
</layout.Page>
