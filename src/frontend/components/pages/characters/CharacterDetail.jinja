{#def world, world_context, nav, character, can_manage, crumbs, animals, tints, pages=None, short_html=None, body_html=None, links=None, current_user=None, auto_edit=False #}
{#css common/Button.css, common/Pill.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/ChoiceGrid.css, editorial/ImageEditor.css, editorial/DocEdit.css, editorial/DocIdentity.css, editorial/DocSummary.css, common/VStack.css, common/Tooltip.css, common/SaveIndicator.css #}
<layout.Page :title="character.name" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="personaggi">
  <editorial.Crumbs :items="crumbs" />

  <editorial.Docbar
    :base="'/worlds/' ~ world.id ~ '/characters/' ~ character.id"
    eyebrow="Personaggio"
    :locked="character.locked"
    :is_draft="character.is_draft"
    :can_manage="can_manage">
    <span class="pill pill--plain">Giocato da {{ character.owner.name }}</span>
    {% if character.is_draft %}
    <button class="btn btn--ghost btn--sm" type="button" data-testid="cancel-character-draft" hx-post="/worlds/{{ world.id }}/characters/{{ character.id }}/cancel-draft" hx-confirm="Annullare questa bozza?" hx-swap="none">Annulla bozza</button>
    {% else %}
    <button class="btn btn--ghost btn--sm" type="button" data-testid="delete-character" hx-delete="/worlds/{{ world.id }}/characters/{{ character.id }}" hx-confirm="Eliminare {{ character.name }}?" hx-swap="none">Elimina</button>
    {% endif %}
  </editorial.Docbar>

  <div class="docpage">
    <div>
      <div class="document">
        <div class="document__head">
          <div class="document__face document__face--editor">
            <editorial.ImageEditor :world_id="world.id" owner_kind="character" :owner_id="character.id"
              :upload_url="'/api/worlds/' ~ world.id ~ '/characters/' ~ character.id ~ '/image'"
              :fallback_action="'/worlds/' ~ world.id ~ '/characters/' ~ character.id ~ '/image'"
              :image_url="character.image_url" :can_manage="can_manage" :locked="character.locked"
              :version="character.version" :tint="character.tint" :symbol="character.animal"
              symbol_name="animal" symbol_kind="emoji" :symbol_options="animals" :tints="tints"
              :label="'Immagine di ' ~ character.name" />
          </div>
          <div class="document__id">
            <editorial.DocIdentity :base="'/worlds/' ~ world.id ~ '/characters/' ~ character.id"
              :can_manage="can_manage" :locked="character.locked" :version="character.version" :auto_edit="auto_edit">
              <span class="eyebrow">Nome</span>
              <h1 class="display" data-doc-field="name">{{ character.name }}</h1>
              <span class="eyebrow">Titolo</span>
              <p class="card__title" data-doc-field="title"
                 {% if not character.title %}data-empty="true"{% endif %}>{{ character.title or '' }}</p>
              <editorial.DocSummary :world_id="world.id" :base="'/worlds/' ~ world.id ~ '/characters/' ~ character.id"
                :value="character.short_description" :value_html="short_html" :version="character.version"
                :can_manage="can_manage" :locked="character.locked" />
            </editorial.DocIdentity>
            <div class="document__page">
              <span class="eyebrow">Descrizione</span>
              <editorial.DocEdit world_id={{ world.id }}
                :base="'/worlds/' ~ world.id ~ '/characters/' ~ character.id"
                :body="character.body" :body_html="body_html"
                :locked="character.locked" :version="character.version" :can_manage="can_manage" />
            </div>
          </div>
        </div>
    </div>
    {% if links %}<editorial.Links :groups="links" />{% endif %}
  </div>
</layout.Page>
