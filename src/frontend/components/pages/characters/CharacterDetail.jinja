{#def world, world_context, nav, character, can_manage, crumbs, current_user=None #}
{#css common/Button.css, common/Pill.css, layout/UserMenu.css #}
<layout.Page :title="character.name" current_user={{ current_user }} :world="world_context" :nav="nav" active="personaggi">
  <editorial.Crumbs :items="crumbs" />

  <div class="docbar">
    <span class="eyebrow">Personaggio</span>
    <div class="docbar__actions">
      <span class="pill pill--plain">Giocato da {{ character.owner.name }}</span>
      {% if character.locked %}<span class="pill pill--plain">Bloccato</span>{% endif %}
      {% if character.is_draft %}<span class="pill pill--draft">Bozza</span>{% endif %}
      {% if can_manage %}
      <a class="btn btn--primary btn--sm" href="/worlds/{{ world.id }}/characters/{{ character.id }}/edit">Modifica</a>
      <button class="btn btn--ghost btn--sm" type="button"
              hx-delete="/worlds/{{ world.id }}/characters/{{ character.id }}"
              hx-confirm="Eliminare {{ character.name }}?" hx-swap="none">Elimina</button>
      {% endif %}
    </div>
  </div>

  <div class="docpage">
    <div>
      <div class="document">
        <div class="document__head">
          <div class="document__face">
            <editorial.Face :tint="character.tint" :animal="character.animal" :image_url="character.image_url" />
          </div>
          <div class="document__id">
            <h1 class="display">{{ character.name }}</h1>
            {% if character.title %}<p class="card__title">{{ character.title }}</p>{% endif %}
            {% if character.short_description %}<p class="lede">{{ character.short_description }}</p>{% endif %}
          </div>
        </div>
        <div class="document__page">
          <span class="eyebrow">Descrizione</span>
          <div class="prose">{{ character.body | markdown }}</div>
        </div>
      </div>
    </div>
  </div>
</layout.Page>
