{#def world, world_context, nav, cards, crumbs, pages=None, drafts=None, current_user=None #}
{#css common/Button.css, common/Grid.css, common/Tooltip.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/EmptyState.css #}
{% set eyebrow_text = (cards | length) ~ (' scheda' if (cards | length) == 1 else ' schede') %}
<layout.Page title="Personaggi" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="personaggi">
  <editorial.Masthead
    title="Personaggi"
    :eyebrow="eyebrow_text"
    lede="I giocatori gestiscono le proprie schede; il Master vede e modifica tutto."
    :crumbs="crumbs">
    <common.Tooltip text="Nuovo personaggio">
      <common.Button :hx-post="'/worlds/' ~ world.id ~ '/characters/new'" hx-swap="none" variant="primary" size="sm" icon="plus" icon_only label="Nuovo personaggio" data-testid="create-character" />
    </common.Tooltip>
  </editorial.Masthead>

  {% if cards %}
  <common.Grid min="card" gap=5>
    {% for card in cards %}<editorial.Card :item="card" />{% endfor %}
  </common.Grid>
  {% else %}
  <common.EmptyState icon="user" title="Nessun personaggio" description="Creane uno per cominciare." />
  {% endif %}

{% if drafts %}
<section class="section">
  <editorial.SectionHead title="Bozze" eyebrow="Non ancora pubblicate" />
  <common.Grid min="card" gap=5>
    {% for card in drafts %}<editorial.Card :item="card" />{% endfor %}
  </common.Grid>
</section>
{% endif %}
</layout.Page>
