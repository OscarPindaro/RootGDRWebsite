{#def world, world_context, nav, character, animals, tints, crumbs, current_user=None #}
{#css common/Button.css, common/Field.css, layout/UserMenu.css #}
{% if character %}
{% set title = "Modifica personaggio" %}
{% set action = "/worlds/" ~ world.id ~ "/characters/" ~ character.id %}
{% else %}
{% set title = "Nuovo personaggio" %}
{% set action = "/worlds/" ~ world.id ~ "/characters/new" %}
{% endif %}
<layout.Page :title="title" current_user={{ current_user }} :world="world_context" :nav="nav" active="personaggi">
  <editorial.Masthead :title="title"
    eyebrow="Scheda"
    lede="Il volto è una tinta e un animale, oppure un'immagine caricata. La descrizione è in Markdown."
    :crumbs="crumbs" />

  <form class="form" hx-post="{{ action }}" hx-swap="none">
    <common.Field label="Nome completo" name="name" type="text" required maxlength=255
                  :value="character.name if character else None" />
    <common.Field label="Titolo" name="title" type="text" maxlength=255
                  helper="Opzionale. Appare sotto il nome."
                  :value="character.title if character else None" />
    <common.Field label="Descrizione breve" name="short_description" type="text" maxlength=1000
                  :value="character.short_description if character else None" />
    <common.Field label="Animale" name="animal" type="select" :options="animals"
                  :value="character.animal if character else '🐈'" />
    <common.Field label="Tinta della scheda" name="tint" type="select" :options="tints"
                  :value="character.tint if character else 'p1'" />
    <common.Field label="Descrizione lunga" name="body" type="textarea"
                  helper="Markdown. Puoi usare @[Nome] per collegare altri contenuti."
                  :value="character.body if character else ''" />
    <div class="row-inline">
      <common.Button type="submit" variant="primary" size="md">Salva</common.Button>
      {% if character %}
      <a class="btn btn--ghost" href="/worlds/{{ world.id }}/characters/{{ character.id }}">Annulla</a>
      {% else %}
      <a class="btn btn--ghost" href="/worlds/{{ world.id }}/characters">Annulla</a>
      {% endif %}
    </div>
  </form>
</layout.Page>
