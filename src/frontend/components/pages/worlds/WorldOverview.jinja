{#def world, world_context, nav, quicks, overview, crumbs, pages=None, current_user=None #}
{#css common/Button.css, common/Card.css, common/Grid.css, common/Pill.css, common/VStack.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css #}
<layout.Page title={{ world.name }} current_user={{ current_user }} active="mondo" :world="world_context" :nav="nav" :pages="pages">
  <editorial.Masthead
    :title="world.name"
    :eyebrow="world_context.role"
    :lede_html="world.description | markdown"
    :crumbs="crumbs">
    <div class="masthead__actions">
      <a class="btn btn--primary" href="/worlds/{{ world.id }}/sessioni/new">Nuova sessione</a>
      <a class="btn btn--ghost" href="/worlds/{{ world.id }}/settings">Impostazioni</a>
    </div>
  </editorial.Masthead>

  <div class="grid grid--quick">
    {% for entry in quicks %}
    <editorial.Quick :entry="entry" :style="current_user.symbol_style" />
    {% endfor %}
  </div>

  <section class="section">
    <div class="grid grid--two">
      <div>
        <editorial.SectionHead title="Come è cambiato il mondo" eyebrow="Diario · ultime 4 sessioni">
          <a class="btn--text" href="/worlds/{{ world.id }}/sessioni">Registro completo</a>
        </editorial.SectionHead>
        {% if overview.diary %}
        <editorial.Timeline :entries="overview.diary" />
        {% else %}
        <div class="empty">Ancora nessuna sessione. Il diario comparirà qui.</div>
        {% endif %}
      </div>

      <div>
        <editorial.SectionHead title="Storia in corso" eyebrow="Arco aperto">
          <a class="btn--text" href="/worlds/{{ world.id }}/storie">Tutte le storie</a>
        </editorial.SectionHead>
        {% if overview.open_story %}
        <a class="story" href="{{ overview.open_story.href }}">
          <div class="story__band" style="background: var(--{{ overview.open_story.tint or 'cobalt' }}); color: var(--surface)">
            <span>{{ overview.open_story.kind }}</span>
          </div>
          <div class="story__body">
            <h3 class="story__title">{{ overview.open_story.title }}</h3>
            <p class="story__sum">{{ overview.open_story.description }}</p>
          </div>
        </a>
        {% else %}
        <div class="empty">Nessun arco narrativo aperto.</div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="section">
    <editorial.SectionHead title="Dove sono adesso" eyebrow="Scena corrente">
      <a class="btn--text" href="/worlds/{{ world.id }}/luoghi">Atlante</a>
    </editorial.SectionHead>
    {% if overview.current_place %}
    <a class="wherenow" href="{{ overview.current_place.href }}" style="--c: var(--{{ overview.current_place.tint or 'p9' }})">
      <span class="plogo plogo--lg" data-shape="rombo" aria-hidden="true"></span>
      <span class="wherenow__name">{{ overview.current_place.title }}</span>
      <span class="wherenow__desc">{{ overview.current_place.description }}</span>
      {% if overview.current_place.meta %}<span class="wherenow__meta">{{ overview.current_place.meta }}</span>{% endif %}
    </a>
    {% else %}
    <div class="empty">Nessuna scena corrente impostata.</div>
    {% endif %}
  </section>
</layout.Page>
