{#def world, world_context, nav, quicks, overview, crumbs, pages=None, current_user=None #}
{#css common/Button.css, common/Grid.css, common/Pill.css, common/Tooltip.css, common/VStack.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/EmptyState.css, common/SaveIndicator.css, editorial/StoryCard.css, editorial/Collection.css, layout/Rail.css, layout/Topbar.css, layout/Palette.css #}
<layout.Page title={{ world.name }} current_user={{ current_user }} active="mondo" :world="world_context" :nav="nav" :pages="pages">
  <editorial.Masthead
    :title="world.name"
    :eyebrow="world_context.role"
    :lede_html="world.description | markdown"
    :crumbs="crumbs">
    <div class="masthead__actions">
      <common.IconButton icon="plus" label="Nuova sessione" variant="primary"
                         :hx-post="'/worlds/' ~ world.id ~ '/sessions/new'" hx-swap="none"
                         data-testid="create-session" />
      <common.IconButton icon="settings" label="Impostazioni del mondo"
                         :href="'/worlds/' ~ world.id ~ '/settings'"
                         data-testid="world-settings" />
    </div>
  </editorial.Masthead>

  <common.Grid min="quick" flush>
    {% for entry in quicks %}
    <editorial.Quick :entry="entry" :style="current_user.symbol_style" />
    {% endfor %}
  </common.Grid>

  <section class="section">
    <common.Grid split gap=10>
      <div>
        <editorial.SectionHead title="Come è cambiato il mondo" eyebrow="Diario · ultime 4 sessioni">
          <common.Button variant="text" :href="'/worlds/' ~ world.id ~ '/sessions'">Registro completo</common.Button>
        </editorial.SectionHead>
        {% if overview.diary %}
        <editorial.Timeline :entries="overview.diary" />
        {% else %}
        <common.EmptyState compact icon="calendar" title="Ancora nessuna sessione" description="Il diario comparirà qui." />
        {% endif %}
      </div>

      <div>
        <editorial.SectionHead title="Storia in corso" eyebrow="Arco aperto">
          <common.Button variant="text" :href="'/worlds/' ~ world.id ~ '/stories'">Tutte le storie</common.Button>
        </editorial.SectionHead>
        {% if overview.open_story %}
        <editorial.StoryCard
          :href="overview.open_story.href"
          :tint="overview.open_story.tint or 'cobalt'"
          :title="overview.open_story.title"
          :summary="overview.open_story.description"
          :status_label="overview.open_story.kind"
          level={{ 3 }} />
        {% else %}
        <common.EmptyState compact icon="book-open" title="Nessun arco narrativo aperto" />
        {% endif %}
      </div>
    </common.Grid>
  </section>

  <section class="section">
    <editorial.SectionHead title="Dove sono adesso" eyebrow="Scena corrente">
      <common.Button variant="text" :href="'/worlds/' ~ world.id ~ '/places'">Atlante</common.Button>
    </editorial.SectionHead>
    {% if overview.current_place %}
    <a class="wherenow collection-surface" href="{{ overview.current_place.href }}" style="--c: var(--{{ overview.current_place.tint or 'p9' }})">
      <span class="plogo plogo--lg" data-shape="rombo" aria-hidden="true"></span>
      <span class="wherenow__name">{{ overview.current_place.title }}</span>
      <span class="wherenow__desc">{{ overview.current_place.description }}</span>
      {% if overview.current_place.meta %}<span class="wherenow__meta">{{ overview.current_place.meta }}</span>{% endif %}
    </a>
    {% else %}
    <common.EmptyState compact icon="map-pin" title="Nessuna scena corrente impostata" />
    {% endif %}
  </section>
</layout.Page>
