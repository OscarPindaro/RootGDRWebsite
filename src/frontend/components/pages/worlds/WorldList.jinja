{#def worlds, total, page, page_size, current_user=None #}
{#css common/Button.css, common/Card.css, common/Grid.css, common/Tooltip.css, common/VStack.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/MediaFrame.css, common/SaveIndicator.css, pages/worlds/WorldList.css, common/Pill.css, layout/Rail.css, layout/Topbar.css, layout/Palette.css, common/Alert.css, common/RequestFallback.css, common/Icon.css, common/Mark.css, editorial/Cover.css, editorial/Crumbs.css, editorial/Masthead.css #}
{% set eyebrow_text = "Archivio · " ~ total ~ (" mondo" if total == 1 else " mondi") %}
<layout.Page title="I tuoi mondi" current_user={{ current_user }} active="worlds">
  <editorial.Masthead
    title="I tuoi mondi"
    :eyebrow="eyebrow_text"
    lede="Ogni mondo è un volume a sé: personaggi, luoghi, sessioni, storie e pagine di riferimento raccolti sotto un'unica copertina.">
    <common.IconButton icon="plus" label="Nuovo mondo" variant="primary" size="sm" href="/worlds/new" data-testid="create-world" />
  </editorial.Masthead>

  {% if worlds %}
  <pages.worlds.WorldGrid worlds={{ worlds }} />
  {% else %}
  <common.Card variant="outlined" class="world-list-empty">
    <common.VStack gap=2 align="center">
      <common.Icon name="map" size=32 />
      <h2>Nessun mondo</h2>
      <p>Crea un mondo per cominciare a documentare le tue avventure.</p>
    </common.VStack>
  </common.Card>
  {% endif %}

  {% if total > page_size %}
  <nav class="world-pagination" aria-label="Pagine dei mondi" style="margin-top: 2rem">
    {% if page > 1 %}
    <a href="/worlds?page={{ page - 1 }}&amp;page_size={{ page_size }}">Precedente</a>
    {% endif %}
    <span>Pagina {{ page }}</span>
    {% if page * page_size < total %}
    <a href="/worlds?page={{ page + 1 }}&amp;page_size={{ page_size }}">Successiva</a>
    {% endif %}
  </nav>
  {% endif %}
</layout.Page>
