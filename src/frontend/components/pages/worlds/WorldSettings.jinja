{#def world, members, world_context, nav, crumbs, description_html, error=None, pages=None, current_user=None #}
{#css common/Alert.css, common/Button.css, common/Dialog.css, common/Field.css, common/Pill.css, layout/UserMenu.css, pages/worlds/WorldSettings.css, editorial/ImageEditor.css, editorial/DocEdit.css, editorial/DocIdentity.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/ChoiceGrid.css #}
<layout.Page title="Impostazioni" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="mondo">
  <editorial.Masthead title="Impostazioni" :eyebrow="world.name" :crumbs="crumbs">
    <a class="btn btn--ghost" href="/worlds/{{ world.id }}">Torna al mondo</a>
  </editorial.Masthead>

  {% if error %}<common.Alert variant="danger">{{ error }}</common.Alert>{% endif %}

  <div class="grid grid--two">
    <div class="stack stack--lg">
      <section class="world-identity">
        <editorial.SectionHead title="Identità" eyebrow="Nome e descrizione" />
        <editorial.DocIdentity :base="'/worlds/' ~ world.id" :version="world.version" :can_manage="True">
          <h2 class="display display--sm" data-doc-field="name" data-doc-label="Nome del mondo">{{ world.name }}</h2>
        </editorial.DocIdentity>
        <span class="eyebrow">Descrizione Markdown</span>
        <editorial.DocEdit world_id={{ world.id }} :base="'/worlds/' ~ world.id"
          :body="world.description" :body_html="description_html" field_name="description"
          label="Descrizione del mondo" :version="world.version" :can_manage="True" />
      </section>

      <section>
        <editorial.SectionHead title="Membri" eyebrow="Master e giocatori" />
        <div class="links">
          <div class="links__head">
            <span class="eyebrow">Chi ha accesso</span>
            <span class="mono muted">{{ members | length }}</span>
          </div>
          <div class="links__group">
            {% for member in members %}
            <div class="links__item">
              <span class="links__dot" style="--c: var(--p8)"></span>
              {{ member.user.name }}
              <span class="mono muted">{{ 'Master' if member.role == 'master' else 'Giocatore' }}</span>
              {% if member.user.id | string != world.created_by.id | string %}
              <button class="btn--text" type="button"
                      hx-delete="/worlds/{{ world.id }}/members/{{ member.user.id }}"
                      hx-confirm="Rimuovere {{ member.user.name }}?"
                      hx-swap="none">Rimuovi</button>
              {% else %}
              <span class="mono muted">proprietario</span>
              {% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
        <form class="row-inline" style="margin-top: 1rem"
              hx-post="/worlds/{{ world.id }}/members"
              hx-ext="ignore:json-enc" hx-swap="none">
          <input class="input" name="email" type="email" required placeholder="email@example.com" aria-label="Email del membro">
          <select class="select" name="role" aria-label="Ruolo">
            <option value="player">Giocatore</option>
            <option value="master">Master</option>
          </select>
          <common.Button type="submit" variant="secondary" size="md" data-testid="add-world-member">Aggiungi</common.Button>
        </form>
      </section>
    </div>

    <aside class="stack">
      <section>
        <editorial.SectionHead title="Copertina" eyebrow="Immagine del mondo" />
        <editorial.ImageEditor :world_id="world.id" owner_kind="world" :owner_id="world.id"
          :upload_url="'/api/worlds/' ~ world.id ~ '/image'"
          :fallback_action="'/worlds/' ~ world.id ~ '/image'"
          :image_url="world.image_url" :can_manage="True" :version="world.version"
          label="Copertina del mondo" />
      </section>
    </aside>
  </div>
</layout.Page>
