{#def world, members, world_context, nav, crumbs, description_html, invites=None, pages=None, current_user=None #}
{#css common/Alert.css, common/Button.css, common/Dialog.css, common/Field.css, common/Pill.css, layout/UserMenu.css, pages/worlds/WorldSettings.css, editorial/ImageEditor.css, editorial/DocEdit.css, editorial/DocIdentity.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/ChoiceGrid.css, common/Grid.css, common/VStack.css, common/HStack.css, common/Tooltip.css, common/SaveIndicator.css, common/Table.css, pages/worlds/WorldMembersTable.css, pages/worlds/WorldMemberDialog.css, common/ConfirmDialog.css, layout/Rail.css, layout/Topbar.css, layout/Palette.css, common/RequestFallback.css #}
{#js common/Dialog.js #}
<layout.Page title="Impostazioni" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="mondo">
  <editorial.Masthead title="Impostazioni" :eyebrow="world.name" :crumbs="crumbs">
    <common.Button variant="secondary" :href="'/worlds/' ~ world.id">Torna al mondo</common.Button>
  </editorial.Masthead>

  <common.Grid split gap=10>
    <common.VStack gap=6 class="world-settings__main">
      <section class="world-identity">
        <span class="eyebrow">Nome</span>
        <editorial.DocIdentity :base="'/worlds/' ~ world.id" :version="world.version" :can_manage="True">
          <h2 class="display display--sm" data-doc-field="name" data-doc-block="name" data-doc-label="Nome del mondo">{{ world.name }}</h2>
        </editorial.DocIdentity>
        <span class="eyebrow">Descrizione</span>
        <editorial.DocEdit world_id={{ world.id }} :base="'/worlds/' ~ world.id"
          :body="world.description" :body_html="description_html" field_name="description"
          label="Descrizione del mondo" :version="world.version" :can_manage="True" />
      </section>

      <section>
        <editorial.SectionHead title="Giocatori" eyebrow="Master e giocatori">
          <common.IconButton icon="plus" label="Aggiungi al mondo"
                             :hx-get="'/worlds/' ~ world.id ~ '/members/dialog'"
                             hx-target="#world-member-dialog" hx-swap="innerHTML"
                             data-testid="world-member-add" />
        </editorial.SectionHead>
        <div id="world-members">
          <pages.worlds.WorldMembersTable :world="world" :members="members"
                                          :invites="invites or []" />
        </div>
        <div id="world-member-dialog"></div>
        <div id="world-member-confirm"></div>
      </section>
    </common.VStack>

    <common.VStack element="aside">
      <section>
        <editorial.SectionHead title="Copertina" eyebrow="Immagine del mondo">
          <common.IconButton icon="history" label="Storico immagini"
                             :data-dialog-open="'image-history-dialog-world-' ~ world.id"
                             data-image-history-open data-testid="image-history-open" />
        </editorial.SectionHead>
        <editorial.ImageEditor :world_id="world.id" owner_kind="world" :owner_id="world.id"
          :upload_url="'/api/worlds/' ~ world.id ~ '/image'"
          :fallback_action="'/worlds/' ~ world.id ~ '/image'"
          :image_url="world.image_url" :can_manage="True" :version="world.version"
          :history_dialog_id="'image-history-dialog-world-' ~ world.id"
          :history_trigger="False"
          label="Copertina del mondo" />
      </section>
    </common.VStack>
  </common.Grid>
</layout.Page>
