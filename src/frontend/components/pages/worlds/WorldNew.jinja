{#def crumbs, current_user=None #}
{#css common/Button.css, common/Field.css, common/HStack.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css #}
<layout.Page title="Nuovo mondo" current_user={{ current_user }}>
  <editorial.Masthead
    title="Nuovo mondo"
    eyebrow="Crea un volume"
    lede="Nome, descrizione e copertina. Potrai invitare i membri dopo averlo creato."
    :crumbs="crumbs" />

  <form class="form"
        hx-post="/worlds/new"
        hx-swap="none">
    <common.Field label="Nome" name="name" type="text" required maxlength=255 placeholder="Le Cronache di Boscochiaro" />
    <common.Field label="Descrizione" name="description" type="textarea" required
                  placeholder="Un bosco diviso fra quattro pretendenti." helper="Markdown. Puoi modificarla in seguito." />
    <common.HStack gap=3>
      <common.Button type="submit" variant="primary" size="md" data-testid="save-world">Crea mondo</common.Button>
      <a class="btn btn--ghost" href="/worlds">Annulla</a>
    </common.HStack>
  </form>
</layout.Page>
