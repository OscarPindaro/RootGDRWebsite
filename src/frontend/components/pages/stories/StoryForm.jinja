{#def world, world_context, nav, story, tints, statuses, sessions, crumbs, pages=None, current_user=None #}
{#css common/Button.css, common/Field.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css #}
{% if story %}
{% set title = "Modifica storia" %}
{% set action = "/worlds/" ~ world.id ~ "/storie/" ~ story.id %}
{% else %}
{% set title = "Nuova storia" %}
{% set action = "/worlds/" ~ world.id ~ "/storie/new" %}
{% endif %}
<layout.Page :title="title" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="storie">
  <editorial.Masthead :title="title" eyebrow="Arco narrativo" :crumbs="crumbs" />

  <form class="form" hx-post="{{ action }}" hx-swap="none">
    <common.Field label="Titolo" name="title" type="text" required maxlength=255
                  :value="story.title if story else None" />
    <common.Field label="Sommario" name="short_description" type="text" maxlength=1000
                  :value="story.short_description if story else None" />
    <common.Field label="Periodo" name="period_label" type="text" maxlength=255
                  helper="Opzionale, per esempio «Inverno, 4° anno»."
                  :value="story.period_label if story else None" />
    <common.Field label="Stato" name="status" type="select" :options="statuses"
                  :value="story.status if story else 'in_corso'" />
    <common.Field label="Tinta" name="tint" type="select" :options="tints"
                  :value="story.tint if story else 'p1'" />

    <label class="field field-outlined">
      <span class="field-label">Sessioni incluse</span>
      <select class="field-input" name="session_ids" multiple size="6">
        {% for option in sessions %}
        <option value="{{ option.value }}"
          {% if story and option.value in (story.sessions | map(attribute='id') | map('string') | list) %}selected{% endif %}>
          {{ option.label }}
        </option>
        {% endfor %}
      </select>
      <span class="field-supporting">Tieni premuto Ctrl/⌘ per selezionare più sessioni.</span>
    </label>

    <common.MarkdownField label="Testo" name="body"
                  helper="Markdown. Puoi usare @[Nome] per collegare altri contenuti."
                  :world_id="world.id"
                  :value="story.body if story else ''" />
    <div class="row-inline">
      <common.Button type="submit" variant="primary" size="md">Salva</common.Button>
      {% if story %}
      <a class="btn btn--ghost" href="/worlds/{{ world.id }}/storie/{{ story.id }}">Annulla</a>
      {% else %}
      <a class="btn btn--ghost" href="/worlds/{{ world.id }}/storie">Annulla</a>
      {% endif %}
    </div>
  </form>
</layout.Page>
