{#def world, world_context, nav, story, can_manage=False, crumbs, pages=None, body_html=None, links=None, current_user=None #}
{#css common/Button.css, common/Pill.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, editorial/DocEdit.css, editorial/DocIdentity.css #}
<layout.Page :title="story.title" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="storie">
  <editorial.Crumbs :items="crumbs" />

  <editorial.Docbar
    :base="'/worlds/' ~ world.id ~ '/stories/' ~ story.id"
    :eyebrow="'Storia · ' ~ ('in corso' if story.status == 'in_corso' else 'chiusa')"
    :locked="story.locked"
    :is_draft="story.is_draft"
    :can_manage="can_manage">
    <button class="btn btn--ghost btn--sm" type="button" data-testid="delete-story"
            hx-delete="/worlds/{{ world.id }}/stories/{{ story.id }}"
            hx-confirm="Eliminare «{{ story.title }}»?" hx-swap="none">Elimina</button>
  </editorial.Docbar>

  <div class="docpage">
    <div>
      <div class="document">
        <div class="document__head document__head--plain">
          <div class="document__id">
            <span class="story__band" style="background: var(--{{ story.tint }}); color: var(--surface); display: inline-flex; gap: 1rem; padding: 0.3rem 0.7rem; margin-bottom: 0.8rem">
              <span>{{ 'In corso' if story.status == 'in_corso' else 'Chiusa' }}</span>
              {% if story.period_label %}<span>{{ story.period_label }}</span>{% endif %}
            </span>
            <editorial.DocIdentity :base="'/worlds/' ~ world.id ~ '/stories/' ~ story.id"
              :can_manage="can_manage" :locked="story.locked">
              <h1 class="display" data-doc-field="title">{{ story.title }}</h1>
              <p class="lede" data-doc-field="short_description"
                 {% if not story.short_description %}data-empty="true"{% endif %}>{{ story.short_description or '' }}</p>
            </editorial.DocIdentity>
          </div>
        </div>
        <div class="document__page">
          <span class="eyebrow">Testo</span>
          <editorial.DocEdit world_id={{ world.id }}
            :base="'/worlds/' ~ world.id ~ '/stories/' ~ story.id"
            :body="story.body" :body_html="body_html"
            :locked="story.locked" :can_manage="can_manage" />
        </div>
      </div>
    </div>

    {% if story.sessions %}
    <aside class="stack">
      <div class="links">
        <div class="links__head">
          <span class="eyebrow">Sessioni incluse</span>
          <span class="mono muted">{{ story.sessions | length }}</span>
        </div>
        <div class="links__group">
          {% for session in story.sessions %}
          <a class="links__item" href="/worlds/{{ world.id }}/sessions/{{ session.id }}" style="--c: var(--{{ session.tint }})">
            <span class="links__dot"></span> {{ session.in_world_date }} · {{ session.title }}
          </a>
          {% endfor %}
        </div>
      </div>
    </aside>
    {% endif %}
    {% if links %}<editorial.Links :groups="links" />{% endif %}
  </div>
</layout.Page>
