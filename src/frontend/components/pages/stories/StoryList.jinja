{#def world, world_context, nav, stories, can_manage=False, crumbs, pages=None, drafts=None, current_user=None #}
{#css common/Button.css, common/Grid.css, common/Tooltip.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/EmptyState.css #}
{% set count = stories | length %}
{% set eyebrow_text = count ~ (' arco' if count == 1 else ' archi') %}
<layout.Page title="Storie" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="storie">
  <editorial.Masthead
    title="Storie"
    :eyebrow="eyebrow_text"
    lede="Archi narrativi che riassumono la campagna a un livello più alto delle singole partite."
    :crumbs="crumbs">
    {% if can_manage %}
    <common.Tooltip text="Nuova storia">
      <common.Button :hx-post="'/worlds/' ~ world.id ~ '/stories/new'" hx-swap="none" variant="primary" size="sm" icon="plus" icon_only label="Nuova storia" data-testid="create-story" />
    </common.Tooltip>
    {% endif %}
  </editorial.Masthead>

  {% if stories %}
  <common.Grid min="story" gap=5>
    {% for story in stories %}
    <a class="story" href="/worlds/{{ world.id }}/stories/{{ story.id }}">
      <div class="story__band" style="background: var(--{{ story.tint }}); color: var(--surface)">
        <span>{{ 'In corso' if story.status == 'in_corso' else 'Chiusa' }}</span>
        {% if story.period_label %}<span>{{ story.period_label }}</span>{% endif %}
      </div>
      <div class="story__body">
        <h2 class="story__title">{{ story.title }}</h2>
        <p class="story__sum">{{ story.short_description }}</p>
        <div class="story__foot">
          <span>{{ story.sessions | length }} sessioni</span>
          <span>{% if story.is_draft %}Bozza{% endif %}</span>
        </div>
      </div>
    </a>
    {% endfor %}
  </common.Grid>
  {% else %}
  <common.EmptyState icon="book-open" title="Nessun arco narrativo" />
  {% endif %}

{% if drafts %}
<section class="section">
  <editorial.SectionHead title="Bozze" eyebrow="Non ancora pubblicate" />
  <div class="rowlist">
    {% for draft in drafts %}
    <a class="row" href="/worlds/{{ world.id }}/stories/{{ draft.id }}" style="--c: var(--{{ draft.tint }})">
      <span><span class="row__name">{{ draft.title }}</span><br><span class="row__desc">{{ draft.short_description }}</span></span>
      <span class="row__meta"><span class="pill pill--draft">Bozza</span></span>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}
</layout.Page>
