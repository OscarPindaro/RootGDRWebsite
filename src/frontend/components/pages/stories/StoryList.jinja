{#def world, world_context, nav, stories, can_manage=False, crumbs, pages=None, drafts=None, current_user=None #}
{#css common/Button.css, common/Grid.css, common/Tooltip.css, layout/UserMenu.css, common/Avatar.css, common/Menu.css, layout/Page.css, common/EmptyState.css, common/SaveIndicator.css, common/Pill.css, editorial/Row.css, editorial/StoryCard.css, layout/Rail.css, layout/Topbar.css, layout/Palette.css #}
{% set count = stories | length %}
{% set eyebrow_text = count ~ (' arco' if count == 1 else ' archi') %}
<layout.Page title="Storie" current_user={{ current_user }} :world="world_context" :nav="nav" :pages="pages" active="storie">
  <editorial.Masthead
    title="Storie"
    :eyebrow="eyebrow_text"
    lede="Archi narrativi che riassumono la campagna a un livello più alto delle singole partite."
    :crumbs="crumbs">
    {% if can_manage %}
    <common.IconButton icon="plus" label="Nuova storia" variant="primary" size="sm" :hx-post="'/worlds/' ~ world.id ~ '/stories/new'" hx-swap="none" data-testid="create-story" />
    {% endif %}
  </editorial.Masthead>

  {% if stories %}
  <common.Grid min="story" gap=5>
    {% for story in stories %}
    <editorial.StoryCard
      :href="'/worlds/' ~ world.id ~ '/stories/' ~ story.id"
      :tint="story.tint"
      :title="story.title"
      :summary="story.short_description"
      :status_label="'In corso' if story.status == 'in_corso' else 'Chiusa'"
      :period_label="story.period_label"
      :session_count="story.sessions | length"
      :draft="story.is_draft" />
    {% endfor %}
  </common.Grid>
  {% else %}
  <common.EmptyState icon="book-open" title="Nessun arco narrativo" />
  {% endif %}

{% if drafts %}
<section class="section">
  <editorial.SectionHead title="Bozze" eyebrow="Non ancora pubblicate" />
  <editorial.RowList>
    {% for draft in drafts %}
    <editorial.Row :href="'/worlds/' ~ world.id ~ '/stories/' ~ draft.id" :tint="draft.tint"
      :name="draft.title" :description="draft.short_description" draft />
    {% endfor %}
  </editorial.RowList>
</section>
{% endif %}
</layout.Page>
