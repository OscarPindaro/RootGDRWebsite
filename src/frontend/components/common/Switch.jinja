{#def label, name, checked=False, disabled=False, helper=None, value="on" #}
{#css common/Switch.css #}
<label class="switch{{ ' switch--disabled' if disabled else '' }}">
  <input class="switch__input" type="checkbox" role="switch" name="{{ name }}" value="{{ value }}"
         {% if checked %}checked{% endif %}{% if disabled %}disabled{% endif %}>
  <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
  <span class="switch__text">
    <span class="switch__label">{{ label }}</span>
    {% if helper %}<span class="switch__helper">{{ helper }}</span>{% endif %}
  </span>
</label>
