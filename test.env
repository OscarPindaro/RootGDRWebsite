# Committed, deterministic, explicitly NON-PRODUCTION test values.
# The test harness prefers this file over .env.test / .env.test.example so a
# fresh checkout can run tests without creating a private .env.test.
# Never put real secrets here.
MIGRATOR__USER=migrator_user
MIGRATOR__PASSWORD=migrator_password
MIGRATOR__DB=backend_test

DATABASE__USER=app_user
DATABASE__PASSWORD=app_password
DATABASE__DB=backend_test

AUTH__JWT_SECRET=test-jwt-secret-not-for-production
AUTH__BOOTSTRAP_ADMIN_EMAIL=e2e-admin@example.com
