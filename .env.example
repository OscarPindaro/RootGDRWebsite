# Development environment template. Copy to `.env`; values are development-only.

# PostgreSQL superuser (used by the postgres container to bootstrap)
POSTGRES_DB=root_gdr_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Second development database, served by the showcase app on 8002
DEV_SHOW_DB=root_gdr_show

# Migrator role: runs Alembic, owns the schema
MIGRATOR__USER=migrator_user
MIGRATOR__PASSWORD=migrator_password
MIGRATOR__DB=root_gdr_dev

# Application role: runtime DML only
DATABASE__USER=app_user
DATABASE__PASSWORD=app_password
DATABASE__DB=root_gdr_dev

# Auth settings the app and hooks require. Generate a real secret elsewhere.
AUTH__JWT_SECRET=dev-jwt-secret-not-for-production
AUTH__BOOTSTRAP_ADMIN_EMAIL=e2e-admin@example.com
